{
  "name": "nkustudy-wxapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:miniprogram": "node scripts/check-miniprogram.js",
    "devtools:open": "node scripts/wechat-devtools.js open --project . --lang zh",
    "devtools:login": "node scripts/wechat-devtools.js islogin --project . --lang zh",
    "devtools:preview": "node scripts/wechat-devtools.js preview --project . --lang zh",
    "release:check": "npm test && node scripts/release-preflight.js",
    "devtools:upload": "npm run release:check && node scripts/wechat-devtools.js upload --project . --lang zh",
    "test:contract": "node --test test/public-api-contract.test.js",
    "test:pages": "node --test test/page-state.test.js",
    "test": "npm run test:contract && npm run test:pages && npm run check:miniprogram"
  },
  "engines": { "node": ">=18" }
}
