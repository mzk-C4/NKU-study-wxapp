.page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}

/* 顶部课程信息 */
.course-header {
  background: var(--paper);
  padding: 24rpx 32rpx 20rpx;
  border-bottom: 2rpx solid rgba(75, 31, 111, .07);
}
.course-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.course-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 筛选 chip 行 */
.chip-row {
  white-space: nowrap;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 16rpx;
  background: var(--paper);
}
.chip-row .chip {
  display: inline-flex;
}

/* 筛选行 */
.filter-line {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
  background: var(--paper);
}
.filter-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  color: #5f5962;
  font-size: 22rpx;
}
.filter-btn.active {
  border-color: var(--purple);
  color: var(--purple);
  font-weight: 600;
}
.arrow {
  font-size: 18rpx;
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  padding: 0 32rpx 22rpx;
  overflow: hidden;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--purple);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 20rpx;
}

/* 底部悬浮按钮 */
.sticky-action {
  position: fixed;
  bottom: 24rpx;
  left: 32rpx;
  right: 32rpx;
  height: 88rpx;
  z-index: 5;
}
.sticky-action .btn {
  width: 100%;
  height: 88rpx;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(75, 31, 111, .3);
}
.btn-icon {
  font-size: 28rpx;
}

/* ===== 指南针 AI 入口 banner ===== */
.compass-banner {
  margin: 24rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #4b1f6f 0%, #6a2e93 60%, #8557a8 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 28rpx rgba(75, 31, 111, .28);
}
.cb-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.cb-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.cb-sub {
  font-size: 21rpx;
  color: rgba(255, 255, 255, .82);
  line-height: 1.4;
}
.cb-arrow {
  font-size: 44rpx;
  color: #d7a63c;
  margin-left: 16rpx;
  font-weight: 700;
}

/* ===== 搜索 + 问 AI 行 ===== */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}
.search-box {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}
.search-ico {
  font-size: 26rpx;
  opacity: .6;
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: var(--ink);
}
.search-clear {
  font-size: 24rpx;
  color: var(--muted);
  width: 40rpx;
  text-align: center;
}
.ask-ai-btn {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: #d7a63c;
  color: #4b1f6f;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(215, 166, 60, .35);
}
