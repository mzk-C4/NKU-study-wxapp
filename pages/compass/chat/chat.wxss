/* 问答页样式（复用全局变量，深色/大字体通过根类名切换） */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* 工具条 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--paper);
  border-bottom: 2rpx solid var(--line);
}
.round-ind { font-size: 24rpx; color: var(--muted); font-weight: 600; }
.tb-actions { display: flex; gap: 14rpx; }
.tb-btn {
  height: 56rpx;
  padding: 0 22rpx;
  display: flex; align-items: center;
  border-radius: 28rpx;
  background: var(--purple-soft);
  color: var(--purple);
  font-size: 22rpx;
  font-weight: 600;
}
.tb-btn:active { opacity: .7; }

/* 提示条 */
.limit-banner, .login-banner {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.limit-banner { background: var(--gold-soft); color: #6f5014; }
.login-banner {
  display: flex; align-items: center; justify-content: space-between;
  background: #fbeaea; color: var(--red);
}
.login-btn {
  padding: 8rpx 22rpx; border-radius: 24rpx;
  background: var(--red); color: #fff; font-size: 22rpx; font-weight: 600;
}
.draft-hint {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  background: var(--purple-soft);
  color: var(--purple);
  font-size: 22rpx;
}
.draft-text { flex: 1; line-height: 1.5; }
.draft-clear { flex-shrink: 0; text-decoration: underline; font-weight: 600; }

/* 消息区 */
.msg-scroll {
  flex: 1;
  padding: 24rpx 24rpx 12rpx;
  box-sizing: border-box;
}

/* 欢迎态 */
.welcome { padding: 40rpx 8rpx; }
.welcome-title { font-size: 40rpx; font-weight: 800; color: var(--purple-deep); }
.welcome-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--muted); line-height: 1.6; }
.sg-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.sg-item {
  padding: 22rpx 24rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  font-size: 26rpx; color: var(--ink);
}
.sg-item:active { background: var(--purple-soft); }

/* 消息行 */
.msg { display: flex; margin-bottom: 24rpx; }
.msg.user { justify-content: flex-end; }
.msg.ai { justify-content: flex-start; gap: 16rpx; }

.ai-avatar {
  width: 64rpx; height: 64rpx; flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--purple), var(--purple-deep));
  color: #fff; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
}
.ai-body {
  max-width: 80%;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

/* 用户气泡 */
.user-bubble {
  max-width: 78%;
  padding: 20rpx 26rpx;
  background: linear-gradient(135deg, var(--purple), var(--purple-deep));
  color: #fff;
  border-radius: 24rpx 8rpx 24rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

/* 等待 */
.typing { display: flex; align-items: center; gap: 12rpx; font-size: 26rpx; color: var(--muted); }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--purple); opacity: .6;
  animation: blink 1s infinite;
}
@keyframes blink { 0%,100%{opacity:.3} 50%{opacity:1} }

/* 错误 */
.err-box {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
}
.err-text { font-size: 26rpx; color: var(--red); line-height: 1.5; flex: 1; }
.err-retry {
  flex-shrink: 0;
  padding: 10rpx 28rpx; border-radius: 24rpx;
  background: var(--red); color: #fff; font-size: 24rpx; font-weight: 600;
}

/* 适用范围 / 时效 */
.scope {
  margin-top: 16rpx; padding: 12rpx 16rpx;
  background: var(--purple-soft); color: var(--purple);
  border-radius: 12rpx; font-size: 22rpx; line-height: 1.5;
}
.scope-label {
  display: inline-block; margin-right: 10rpx;
  font-weight: 700;
}
.timeliness {
  margin-top: 10rpx; font-size: 22rpx; color: var(--muted); line-height: 1.5;
}
.sources { margin-top: 14rpx; }
.sources-title {
  font-size: 22rpx; font-weight: 700; color: var(--muted);
  margin-bottom: 4rpx;
}

/* 输入栏 */
.input-bar {
  display: flex; align-items: flex-end; gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 2rpx solid var(--line);
}
.input {
  flex: 1;
  max-height: 200rpx;
  min-height: 72rpx;
  padding: 18rpx 22rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink);
}
.send-btn {
  height: 72rpx; padding: 0 32rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 22rpx;
  background: var(--purple); color: #fff;
  font-size: 28rpx; font-weight: 700;
  flex-shrink: 0;
}
.send-btn.disabled { opacity: .5; }

/* ===== 深色模式（覆盖设计变量） ===== */
.is-dark {
  --bg: #171020;
  --paper: #241a30;
  --ink: #ece7f0;
  --muted: #a89fb2;
  --line: #3a2d47;
  --purple-soft: #2e2140;
  --gold-soft: #3a2e1a;
  --shadow: 0 18rpx 48rpx rgba(0,0,0,.4);
}

/* ===== 大字体模式 ===== */
.is-large .welcome-title { font-size: 46rpx; }
.is-large .user-bubble,
.is-large .ai-body,
.is-large .typing { font-size: 32rpx; }
.is-large .timeliness,
.is-large .scope { font-size: 26rpx; }
.is-large .input { font-size: 32rpx; }
.is-large .send-btn { font-size: 32rpx; }
