.page.compass-home {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* 品牌区 */
.hero { padding: 24rpx 8rpx 8rpx; }
.hero-badge {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--purple), var(--purple-deep));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--purple-deep);
  line-height: 1.3;
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* 主入口卡片 */
.entry-card {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, var(--purple), var(--purple-deep));
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}
.entry-icon {
  width: 84rpx; height: 84rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,.16);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.entry-main { flex: 1; }
.entry-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.entry-desc { font-size: 22rpx; color: rgba(255,255,255,.78); margin-top: 6rpx; }
.entry-arrow { color: #fff; font-size: 44rpx; }

/* 示例问题 */
.sg-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 4rpx; }
.sg-item {
  padding: 24rpx 26rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.4;
}
.sg-item:active { background: var(--purple-soft); }

.tip {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
  text-align: center;
}
