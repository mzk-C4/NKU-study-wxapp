:host { position: relative; z-index: 10000; }
.intro { position: fixed; inset: 0; z-index: 10000; overflow: hidden; background: #FFFDF8; color: #4B1F6F; opacity: 1; transition: opacity 240ms ease-out; }
.intro--dark { background: #15111D; color: #F7F0FF; }
.intro--leaving { opacity: 0; }
.intro-glow { position: absolute; width: 960rpx; height: 960rpx; pointer-events: none; }
.intro-glow--purple { left: -130rpx; top: 4%; background: radial-gradient(ellipse at center, rgba(136, 75, 196, .17), rgba(136, 75, 196, 0) 66%); animation: intro-drift 1800ms ease-out both; }
.intro--dark .intro-glow--purple { background: radial-gradient(ellipse at center, rgba(111, 38, 193, .36), rgba(111, 38, 193, 0) 66%); }
.intro-glow--blue { right: -490rpx; bottom: -160rpx; background: radial-gradient(ellipse at center, rgba(89, 150, 181, .12), rgba(89, 150, 181, 0) 66%); animation: intro-ambient 1600ms ease-out both; }
.intro--dark .intro-glow--blue { background: radial-gradient(ellipse at center, rgba(36, 114, 147, .16), rgba(36, 114, 147, 0) 66%); }
.intro-orbit { position: absolute; left: 50%; top: 44%; width: 600rpx; height: 600rpx; margin-left: -300rpx; margin-top: -300rpx; border: 1rpx solid rgba(117, 68, 157, .12); border-radius: 50%; pointer-events: none; animation: intro-orbit 1500ms 150ms ease-out both; }
.intro--dark .intro-orbit { border-color: rgba(190, 149, 227, .12); }
.intro-orbit--two { animation-delay: 350ms; }
.intro-center { position: absolute; top: 44%; left: 32rpx; right: 32rpx; transform: translateY(-50%); text-align: center; }
.intro-logo-wrap { position: relative; width: 240rpx; height: 240rpx; margin: 0 auto 30rpx; overflow: hidden; border: 1rpx solid rgba(213,181,117,.55); border-radius: 44rpx; background: #4B1F6F; box-shadow: 0 12rpx 36rpx rgba(75,31,111,.16); animation: intro-reveal 650ms 40ms ease-out both; }
.intro-logo { display: block; width: 100%; height: 100%; }
.intro-logo-wrap .intro-logo-shine { animation-delay: 180ms; }
.intro-wordmark { display: inline-block; position: relative; overflow: hidden; font-family: Georgia, 'Times New Roman', serif; font-size: 100rpx; line-height: 1.3; font-weight: 700; letter-spacing: -4rpx; padding: 0 12rpx; animation: intro-reveal 700ms 100ms cubic-bezier(.16, 1, .3, 1) both; }
.intro-shine { position: absolute; top: 0; bottom: 0; left: 0; width: 70rpx; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .85), transparent); transform: translateX(-100rpx) skewX(-15deg); animation: intro-sweep 750ms 280ms ease-in-out both; pointer-events: none; }
.intro-stroke { width: 240rpx; height: 5rpx; margin: 6rpx auto 34rpx; border-radius: 100%; background: linear-gradient(90deg, transparent, #AB77CF, #D5B575, transparent); transform-origin: left center; animation: intro-line 600ms 320ms ease-out both; }
.intro-caption { font-size: 28rpx; line-height: 1.8; letter-spacing: 8rpx; padding-left: 8rpx; animation: intro-caption 500ms 630ms ease-out both; }
.intro-subtitle { margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; letter-spacing: 3rpx; color: #766580; animation: intro-caption 500ms 760ms ease-out both; }
.intro--dark .intro-subtitle { color: #C2B2D2; }
.intro-skip { position: absolute; top: 26rpx; right: 28rpx; width: auto !important; margin: 0 !important; padding: 0 28rpx; min-width: 132rpx; height: 88rpx; line-height: 88rpx; font-size: 26rpx; font-weight: 400; color: #766580; background: transparent; border: 0; border-radius: 44rpx; }
.intro-skip::after { border: 0; }
.intro-skip text { margin-left: 12rpx; }
.intro--dark .intro-skip { color: #C2B2D2; }
.intro-footer { position: absolute; left: 24rpx; right: 24rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); text-align: center; font-size: 26rpx; line-height: 1.8; letter-spacing: 4rpx; color: #766580; animation: intro-caption 500ms 800ms ease-out both; }
.intro-disclaimer { margin-top: 14rpx; font-size: 20rpx; letter-spacing: 1rpx; }
.intro--dark .intro-footer { color: #C2B2D2; }
@keyframes intro-reveal { from { opacity: 0; transform: translateY(16rpx) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes intro-caption { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes intro-sweep { from { transform: translateX(-100rpx) skewX(-15deg); opacity: 0; } 20% { opacity: .7; } 80% { opacity: .7; } to { transform: translateX(620rpx) skewX(-15deg); opacity: 0; } }
@keyframes intro-line { from { opacity: 0; transform: scaleX(.2); } to { opacity: 1; transform: scaleX(1); } }
@keyframes intro-orbit { from { opacity: 0; transform: scale(.7); } 35% { opacity: 1; } to { opacity: 0; transform: scale(1.5); } }
@keyframes intro-drift { from { opacity: .4; transform: translate(-30rpx, 30rpx) scale(.9); } to { opacity: 1; transform: translate(30rpx, -20rpx) scale(1.05); } }
@keyframes intro-ambient { from { opacity: 0; transform: translateY(40rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  .intro-glow, .intro-orbit, .intro-logo-wrap, .intro-wordmark, .intro-shine, .intro-stroke, .intro-caption, .intro-subtitle, .intro-footer { animation: none; }
  .intro-orbit, .intro-shine { display: none; }
  .intro { transition: none; }
}
