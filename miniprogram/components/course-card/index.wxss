.course { display: block; width: 100% !important; min-width: 100%; max-width: 100%; margin: 0 !important; padding: 26rpx; border: 1rpx solid #E8E2EC; border-radius: 26rpx; color: #2B123E; background: #FFFDF8; box-sizing: border-box; text-align: left; line-height: normal; }
.course::after { border: 0; }
.course--pressed { opacity: .86; }
.course-head { display: flex; gap: 18rpx; align-items: flex-start; }
.zone { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 18rpx; color: #FFFFFF; background: #4B1F6F; font-weight: 700; }
.course-main { flex: 1; min-width: 0; }
.course-name { font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.course-sub { margin-top: 6rpx; color: #6F6972; font-size: 20rpx; }
.arrow { color: #817A84; font-size: 44rpx; line-height: 1; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.stats { display: flex; gap: 26rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx dashed #E8E2EC; color: #6F6972; font-size: 20rpx; }
