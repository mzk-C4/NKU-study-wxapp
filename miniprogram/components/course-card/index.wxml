<button class="course" bindtap="select" hover-class="course--pressed" hover-stay-time="80">
  <view class="course-head">
    <view class="zone">课</view>
    <view class="course-main"><view class="course-name">{{course.name}}</view><view class="course-sub">{{course.group || '分类待补充'}} · {{course.term || '修读阶段待补充'}}</view></view>
    <view class="arrow">›</view>
  </view>
  <view class="tags"><tag-chip wx:for="{{course.tags}}" wx:key="*this" text="{{item}}"></tag-chip></view>
  <view class="stats"><text>{{course.resource_count}} 份资料</text><text>{{course.review_count}} 条评价</text><text>{{course.ratings.label}}</text></view>
</button>
