.state { min-height: 260rpx; padding: 48rpx 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #6F6972; box-sizing: border-box; }
.state-title { color: #211C24; font-size: 30rpx; font-weight: 700; }
.state-text { margin-top: 12rpx; font-size: 23rpx; }
.spinner { width: 42rpx; height: 42rpx; margin-bottom: 20rpx; border: 5rpx solid #E8E2EC; border-top-color: #4B1F6F; border-radius: 50%; animation: spin .8s linear infinite; }
.retry { margin-top: 24rpx; padding: 0 34rpx; height: 68rpx; line-height: 68rpx; color: #FFFFFF; background: #4B1F6F; border-radius: 18rpx; font-size: 24rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
