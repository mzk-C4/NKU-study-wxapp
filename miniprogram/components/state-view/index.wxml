<view wx:if="{{loading}}" class="state"><view wx:if="{{skeleton}}" class="skeleton" aria-hidden="true"><view class="skeleton-card"><view class="skeleton-line"></view><view class="skeleton-line short"></view></view><view class="skeleton-card"><view class="skeleton-line"></view><view class="skeleton-line short"></view></view></view><view wx:else class="spinner"></view><text>正在加载...</text></view>
<view wx:elif="{{error}}" class="state"><text class="state-title">暂时无法加载</text><text class="state-text">{{error}}</text><button class="retry" hover-class="retry--pressed" hover-stay-time="80" bindtap="retry">重新加载</button></view>
<view wx:elif="{{empty}}" class="state"><text class="state-title">{{emptyText}}</text><slot></slot></view>
