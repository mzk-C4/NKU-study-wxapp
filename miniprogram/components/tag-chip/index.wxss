.tag { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: 12rpx; font-size: 20rpx; font-weight: 600; box-sizing: border-box; }
.tag--purple { color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #EFE8F4); }
.tag--gold { color: var(--nk-gold, #795514); background: var(--nk-gold-soft, #F8EFD9); }
.tag--green { color: var(--nk-green, #27865F); background: var(--nk-soft, #E8F5EF); }
.tag--gray { color: var(--nk-muted, #6F6972); background: var(--nk-soft, #F0EDF1); }
