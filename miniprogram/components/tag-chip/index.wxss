.tag { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: 12rpx; font-size: 20rpx; font-weight: 600; box-sizing: border-box; }
.tag--purple { color: #4B1F6F; background: #EFE8F4; }
.tag--gold { color: #795514; background: #F8EFD9; }
.tag--green { color: #27865F; background: #E8F5EF; }
.tag--gray { color: #6F6972; background: #F0EDF1; }

/* FB-18: 暗色模式 */
@media (prefers-color-scheme: dark) {
  .tag--purple { background: #3D2A4E; color: #C9B8D8; }
  .tag--gold { background: #3D3520; color: #D4BC8A; }
  .tag--green { background: #1E3028; color: #8BC4A8; }
  .tag--gray { background: #2D2838; color: #8B8090; }
}
