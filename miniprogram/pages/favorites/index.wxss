.history-name { font-weight: 700; font-size: 28rpx; color: var(--nk-text, #2A232E); }
.micro { font-size: 22rpx; color: var(--nk-muted, #9CA3AF); margin-top: 6rpx; }
.record-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx 26rpx; margin-bottom: 16rpx; color: var(--nk-muted, #9CA3AF); }
.record-main { flex: 1; min-width: 0; }
.empty-record { text-align: center; color: var(--nk-muted, #6F6972); padding: 48rpx 28rpx; }
.micro { color:var(--nk-muted, #6F6972); line-height:1.6; }
