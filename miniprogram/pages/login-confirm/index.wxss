.page { padding: 32rpx; }

.card {
  background: var(--card-bg, #fff);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title { font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.desc { font-size: 26rpx; color: var(--muted, #64748b); line-height: 1.6; }

.ticket-box {
  margin: 28rpx 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.35);
  border-radius: 14rpx;
  display: flex; flex-direction: column; gap: 8rpx;
}
.ticket-label { font-size: 22rpx; color: var(--muted, #64748b); }
.ticket { font-size: 30rpx; font-weight: 600; word-break: break-all; }

.manual { margin: 28rpx 0; display: flex; gap: 12rpx; align-items: center; }
.input {
  flex: 1; min-height: 68rpx; padding: 0 20rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.35); border-radius: 12rpx;
  font-size: 26rpx;
}

.btn { margin-top: 20rpx; width: 100%; }
.btn.primary { background: var(--brand, #4b1f6f); color: #fff; }

.ok { font-size: 34rpx; font-weight: 700; color: #16a34a; margin: 24rpx 0 8rpx; }
.warn { margin-top: 16rpx; font-size: 24rpx; color: #d97706; }
.error { margin-top: 16rpx; font-size: 24rpx; color: #dc2626; }
