<view class="page">
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleFeedbacks.length && !searchKeyword}}" empty-text="暂无反馈" bindretry="loadFeedback"></state-view>

  <view class="card section">
    <view class="section-title" style="font-size: 30rpx;margin-bottom: 16rpx;">提交新反馈</view>
    <view style="display:flex;gap:14rpx;margin-bottom: 16rpx;flex-wrap:wrap;">
      <view wx:for="{{typeOptions}}" wx:key="value" class="micro" style="padding:8rpx 24rpx;border:1rpx solid {{type === item.value ? '#4B1F6F' : '#DED5E2'}};border-radius:999rpx;color:{{type === item.value ? '#4B1F6F' : '#6F6972'}};background:{{type === item.value ? '#F4EEF7' : '#FFFFFF'}};font-weight:{{type === item.value ? '700' : '400'}};" data-value="{{item.value}}" bindtap="chooseType">{{item.label}}</view>
    </view>
    <input class="input" style="margin-bottom: 16rpx;" placeholder="标题" value="{{title}}" bindinput="inputTitle" maxlength="120" />
    <textarea class="textarea" style="margin-bottom: 16rpx;min-height:160rpx;" placeholder="详细描述问题或建议" value="{{content}}" bindinput="inputContent" maxlength="2000" />
    <input class="input" style="margin-bottom: 16rpx;" placeholder="联系方式（选填）" value="{{contact}}" bindinput="inputContact" maxlength="120" />
    <button class="button button--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交反馈</button>
  </view>

  <view class="card" style="padding: 20rpx 24rpx;">
    <view style="display:flex;gap:14rpx;align-items:center;">
      <input class="input" style="flex:1;margin-bottom:0;" placeholder="搜索反馈标题、内容或回复" value="{{searchKeyword}}" bindinput="inputSearchKeyword" />
      <view wx:if="{{searchKeyword}}" class="micro" style="padding:8rpx 16rpx;color:#6F6972;" bindtap="clearSearchKeyword">清除</view>
    </view>
    <scroll-view scroll-x style="margin-top:14rpx;white-space:nowrap;">
      <view wx:for="{{statusOptions}}" wx:key="value" class="micro" style="display:inline-block;padding:8rpx 24rpx;margin-right:12rpx;border:1rpx solid {{filterStatus === item.value ? '#4B1F6F' : '#DED5E2'}};border-radius:999rpx;color:{{filterStatus === item.value ? '#4B1F6F' : '#6F6972'}};background:{{filterStatus === item.value ? '#F4EEF7' : '#FFFFFF'}};font-weight:{{filterStatus === item.value ? '700' : '400'}};" data-value="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
    </scroll-view>
  </view>

  <view class="card" wx:for="{{visibleFeedbacks}}" wx:key="id" style="margin-bottom: 16rpx;">
    <view style="display:flex;justify-content:space-between;align-items:center;">
      <view style="display:flex;align-items:center;gap:10rpx;min-width:0;">
        <text class="micro" style="flex-shrink:0;padding:2rpx 12rpx;border:1rpx solid #DED5E2;border-radius:999rpx;color:#6F6972;">{{item.typeLabel}}</text>
        <text style="font-weight:700;font-size:28rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{item.title}}</text>
      </view>
      <text class="micro" style="flex-shrink:0;color:{{item.status === 'completed' ? '#16a34a' : item.status === 'rejected' ? '#dc2626' : '#6F6972'}};">{{item.statusLabel}}</text>
    </view>
    <view class="micro" style="margin-top: 8rpx;">{{item.content}}</view>
    <view wx:if="{{item.reply}}" style="margin-top: 12rpx;padding: 14rpx;border-radius: 12rpx;background: rgba(75, 31, 111, 0.06);">
      <view class="micro" style="color: #4B1F6F;font-weight: 700;">管理员回复</view>
      <view class="micro" style="margin-top: 6rpx;">{{item.reply}}</view>
      <view wx:if="{{item.repliedAt}}" class="micro" style="margin-top: 4rpx;color: #9CA3AF;">{{item.repliedAt}}</view>
    </view>
    <view class="micro" style="margin-top: 8rpx;color: #9CA3AF;">{{item.createdAtLabel}}</view>
  </view>

  <view class="micro" wx:if="{{!loading && !error && searchKeyword && !visibleFeedbacks.length}}" style="text-align:center;padding:32rpx;color:#9CA3AF;">没有匹配「{{searchKeyword}}」的反馈</view>
</view>
