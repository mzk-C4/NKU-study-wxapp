<view class="page {{themeClass}}">
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !feedbacks.length}}" empty-text="暂无反馈" bindretry="loadFeedback"></state-view>

  <view class="chips section" style="margin-top: 0;">
    <view wx:for="{{statusOptions}}" wx:key="value" class="chip {{filterStatus === item.value ? 'chip--active' : ''}}" data-value="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </view>

  <view class="card" wx:for="{{feedbacks}}" wx:key="id" wx:if="{{filterStatus === 'all' || item.status === filterStatus}}" style="margin-bottom: 16rpx;">
    <view style="display:flex;justify-content:space-between;align-items:center;">
      <text style="font-weight:700;font-size:28rpx;">{{item.title}}</text>
      <text class="micro" style="color:{{item.status === 'completed' ? '#16a34a' : item.status === 'rejected' ? '#dc2626' : '#6F6972'}};">{{item.statusLabel}}</text>
    </view>
    <view class="micro" style="margin-top: 8rpx;">{{item.content}}</view>
    <view class="micro" style="margin-top: 8rpx;color: #9CA3AF;">{{item.createdAt}}</view>
  </view>

  <view class="card section">
    <view class="section-title" style="font-size: 30rpx;margin-bottom: 16rpx;">提交新反馈</view>
    <input class="input" style="margin-bottom: 16rpx;" placeholder="标题" value="{{title}}" bindinput="inputTitle" maxlength="120" />
    <textarea class="textarea" style="margin-bottom: 16rpx;min-height:160rpx;" placeholder="详细描述问题或建议" value="{{content}}" bindinput="inputContent" maxlength="2000" />
    <input class="input" style="margin-bottom: 16rpx;" placeholder="联系方式（选填）" value="{{contact}}" bindinput="inputContact" maxlength="120" />
    <button class="button button--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交反馈</button>
  </view>
</view>
