.input { height: 80rpx; padding: 0 20rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 16rpx; background: var(--nk-surface, #FFF); font-size: 26rpx; }
.textarea { padding: 16rpx 20rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 16rpx; background: var(--nk-surface, #FFF); font-size: 26rpx; width: 100%; box-sizing: border-box; }

.feedback-mine-head { font-size: 30rpx; font-weight: 800; color: var(--nk-text, #2A232E); padding: 10rpx 4rpx 16rpx; }
