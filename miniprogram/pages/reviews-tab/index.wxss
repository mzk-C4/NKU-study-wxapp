.reviews-search { margin-bottom: 16rpx; }
.reviews-search-input { flex: 1; font-size: 28rpx; color: var(--nk-text, #241F26); }
.reviews-search-clear { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0 0 0 12rpx; padding: 0; border: 0; border-radius: 50%; color: var(--nk-muted, #6F6972); background: var(--nk-soft, #E8E2EC); font-size: 38rpx; font-weight: 400; line-height: 64rpx; text-align: center; }
.reviews-search-clear::after { border: 0; }
.reviews-search-clear--pressed { opacity: .65; }
.reviews-page { padding: 28rpx 28rpx calc(160rpx + env(safe-area-inset-bottom)); }
.reviews-summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 16rpx; margin: 22rpx 0; color: var(--nk-muted, #6F6972); font-size: 22rpx; line-height: 1.5; font-variant-numeric: tabular-nums; }
.reviews-intro { margin-left: auto; }
.reviews-list-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; margin: 24rpx 0 20rpx; }
.reviews-list-title { color: var(--nk-text, #211C24); font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.review-group-card { padding: 26rpx 28rpx; margin-bottom: 20rpx; border-radius: 28rpx; }
.reviews-page .review-group-card + .review-group-card { margin-top: 0; }
.group-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.group-left { flex: 1; min-width: 0; }
.group-course, .group-teacher { display: block; }
.group-course { font-size: 30rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.group-teacher { margin-top: 6rpx; }
.group-right { text-align: right; flex-shrink: 0; font-variant-numeric: tabular-nums; }
.group-score { font-size: 46rpx; font-weight: 700; line-height: 1.1; color: var(--nk-accent, #4B1F6F); }
.group-score-unit { margin-left: 6rpx; color: var(--nk-muted, #6F6972); font-size: 20rpx; font-weight: 400; }
.group-review-count { margin-top: 6rpx; white-space: nowrap; }
.group-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx 16rpx; margin-top: 16rpx; }
.group-tags { display: flex; flex-wrap: wrap; gap: 12rpx; min-width: 0; }
.group-tag { max-width: 100%; padding: 4rpx 14rpx; border-radius: 10rpx; color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #EFE8F4); font-size: 22rpx; line-height: 1.5; word-break: break-all; box-sizing: border-box; }
.group-tag--neutral { color: var(--nk-muted, #625969); background: var(--nk-soft, #F0EDF1); }
.group-views { margin-left: auto; color: var(--nk-muted, #6F6972); font-size: 22rpx; line-height: 1.5; white-space: nowrap; font-variant-numeric: tabular-nums; }

/* 右下角写评价悬浮按钮 */
.write-review-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 50;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: var(--nk-primary, #4B1F6F);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(75, 31, 111, 0.35);
}
.write-review-fab:active {
  opacity: 0.85;
}
