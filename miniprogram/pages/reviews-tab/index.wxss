.reviews-search { margin-bottom: 16rpx; }
.reviews-search-input { flex: 1; font-size: 28rpx; color: #241F26; }
.reviews-search-clear { flex: 0 0 64rpx; width: 64rpx; min-width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0 0 0 12rpx; padding: 0; border: 0; border-radius: 50%; color: #6F6972; background: #E8E2EC; font-size: 38rpx; font-weight: 400; line-height: 64rpx; text-align: center; }
.reviews-search-clear::after { border: 0; }
.reviews-search-clear--pressed { opacity: .65; }
.review-group-card { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 26rpx; margin-bottom: 16rpx; }
.group-course, .group-teacher { display: block; }
.group-course { font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.group-right { text-align: right; flex-shrink: 0; margin-left: 20rpx; }
.group-score { font-size: 36rpx; font-weight: 700; color: #4B1F6F; }
