<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" background-text-style="{{themeLoading}}"><navigation-bar front-color="{{themeFront}}" background-color="{{themeNavigation}}" /></page-meta>
<view class="page reviews-page">
  <view class="search-box reviews-search">
    <view class="search-icon"></view>
    <input class="reviews-search-input" value="{{keyword}}" placeholder="搜索课程或教师" maxlength="80" confirm-type="search" aria-label="搜索课程或教师" bindinput="inputKeyword" bindconfirm="dismissKeyboard" />
    <button wx:if="{{keyword}}" class="reviews-search-clear" aria-label="清除搜索词" hover-class="reviews-search-clear--pressed" catchtap="clearKeyword">×</button>
  </view>
  <view class="reviews-summary">
    <text>{{statCourses}} 门课 · {{statReviews}} 条评价</text>
    <text class="reviews-intro" wx:if="{{!hasSearchQuery}}">选课前，看看大家怎么说</text>
  </view>
  <view class="reviews-list-head"><view class="reviews-list-title">{{hasSearchQuery ? '搜索结果' : '全部课评'}}</view><text class="micro">评分与评价数一起看</text></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleGroups.length}}" empty-text="{{hasSearchQuery ? '没有匹配的课程或教师' : '暂无评价'}}" bindretry="loadGroups"></state-view>
  <view class="card review-group-card" wx:for="{{visibleGroups}}" wx:key="group_key" data-group="{{item}}" bindtap="openGroup">
    <view class="group-head">
      <view class="group-left">
        <rich-text class="group-course" nodes="{{item.highlighted_course_name}}"></rich-text>
        <rich-text class="micro group-teacher" nodes="{{item.highlighted_teacher_name}}"></rich-text>
      </view>
      <view class="group-right">
        <view class="group-score" wx:if="{{item.rating_average}}">{{item.rating_average}}<text class="group-score-unit">/5</text></view>
        <view class="micro" wx:else>暂无评分</view>
        <view class="micro group-review-count">{{item.review_count}} 条评价</view>
      </view>
    </view>
    <view class="group-meta" wx:if="{{item.tag_counts.length || item.browse_count_label}}">
      <view class="group-tags" wx:if="{{item.tag_counts.length}}"><text class="group-tag {{index ? 'group-tag--neutral' : ''}}" wx:for="{{item.tag_counts}}" wx:key="tag" wx:for-item="tagCount">{{tagCount.tag}} · {{tagCount.count}}</text></view>
      <text class="group-views" wx:if="{{item.browse_count_label}}">{{item.browse_count_label}} 次浏览</text>
    </view>
  </view>
  <view class="micro muted" wx:if="{{hasMore && !loading}}" style="text-align:center;padding:24rpx;" bindtap="loadMore">点击加载更多</view>
  <view class="write-review-fab" bindtap="writeReview" aria-role="button" aria-label="写评价">✍ 写评价</view>
</view>
