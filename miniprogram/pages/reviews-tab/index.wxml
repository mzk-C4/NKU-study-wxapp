<view class="page {{themeClass}}">
  <view class="search-box" bindtap="" style="margin-bottom: 20rpx;"><view class="search-icon"></view><text>浏览全部课程评价</text></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !groups.length}}" empty-text="暂无评价" bindretry="loadGroups"></state-view>
  <view class="card review-group-card" wx:for="{{groups}}" wx:key="group_key" data-group="{{item}}" bindtap="openGroup">
    <view class="group-left">
      <view class="group-course">{{item.course_name}}</view>
      <view class="micro">{{item.teacher_name}}</view>
    </view>
    <view class="group-right">
      <view class="group-score" wx:if="{{item.rating_average}}">{{item.rating_average}}</view>
      <view class="micro">{{item.review_count}} 条</view>
    </view>
  </view>
  <view class="micro muted" wx:if="{{hasMore && !loading}}" style="text-align:center;padding:20rpx;">上拉加载更多</view>
</view>
