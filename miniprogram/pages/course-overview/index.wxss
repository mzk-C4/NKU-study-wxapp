.detail-hero { padding: 30rpx 32rpx 34rpx; color: #FFFFFF; background: #4B1F6F; }
.detail-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 20rpx; }
.detail-title { font-size: 46rpx; line-height: 1.3; font-weight: 700; }
.detail-meta { margin-top: 12rpx; color: rgba(255,255,255,.75); font-size: 22rpx; }
.favorite { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: rgba(255,255,255,.13); font-size: 40rpx; }
.favorite--active { color: #F3CF72; background: rgba(215,166,60,.2); }.favorite--busy { opacity: .62; }
.detail-tabs { display: grid; grid-template-columns: repeat(3, 1fr); height: 90rpx; background: #FFFDF8; border-bottom: 1rpx solid #E8E2EC; }
.detail-tab { position: relative; display: flex; align-items: center; justify-content: center; color: #6F6972; font-size: 24rpx; }
.detail-tab--active { color: #4B1F6F; font-weight: 700; }
.detail-tab--active::after { content: ""; position: absolute; left: 34%; right: 34%; bottom: 0; height: 6rpx; border-radius: 6rpx 6rpx 0 0; background: #4B1F6F; }
.metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.metric { padding: 24rpx 10rpx; display: flex; flex-direction: column; align-items: center; border: 1rpx solid #E8E2EC; border-radius: 24rpx; background: #FFFDF8; color: #6F6972; font-size: 20rpx; }
.metric-value { margin-bottom: 6rpx; color: #4B1F6F; font-family: Georgia, serif; font-size: 38rpx; font-weight: 700; }
.rule-title { padding-left: 16rpx; border-left: 8rpx solid #D7A63C; font-size: 30rpx; font-weight: 700; }
.description { margin-top: 20rpx; color: #4F4951; font-size: 24rpx; line-height: 1.7; }
.md-line { margin-top: 10rpx; }
.md-line:first-child { margin-top: 0; }
.md-item { position: relative; padding-left: 26rpx; }
.md-item::before { content: ""; position: absolute; left: 6rpx; top: 15rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #D7A63C; }
.md-link { color: #6B3A8E; text-decoration: underline; }
.offering { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #E8E2EC; }
.offering:last-child { border-bottom: 0; }
.teacher-avatar { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 50%; color: #FFFFFF; background: #4B1F6F; font-weight: 700; }
.offering-main { flex: 1; }
.teacher-name { margin-bottom: 6rpx; font-weight: 700; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
