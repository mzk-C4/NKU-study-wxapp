<view class="course-detail">
  <state-view loading="{{loading}}" error="{{error}}" bindretry="loadCourse"></state-view>
  <block wx:if="{{course}}">
    <view class="detail-hero"><view class="detail-row"><view><view class="detail-title">{{course.name}}</view><view class="detail-meta">{{course.group || '分类待补充'}} · {{course.term || '学期待补充'}}{{course.assessment ? ' · ' + course.assessment : ''}}</view></view><view class="favorite" bindtap="toggleFavorite">♡</view></view></view>
    <view class="detail-tabs"><view class="detail-tab detail-tab--active">概览</view><view class="detail-tab" data-tab="resources" bindtap="openTab">资料 {{course.resource_count}}</view><view class="detail-tab" data-tab="reviews" bindtap="openTab">评价 {{course.review_count}}</view></view>
    <view class="page detail-body">
      <view class="metric-grid"><view class="metric"><text class="metric-value">{{course.ratings.show_aggregate ? course.ratings.average : '—'}}</text><text>总体评分</text></view><view class="metric"><text class="metric-value">{{course.resource_count}}</text><text>课程资料</text></view><view class="metric"><text class="metric-value">{{course.review_count}}</text><text>公开评价</text></view></view>
      <view class="card section"><view class="rule-title">课程概览</view><view class="description"><block wx:for="{{descriptionBlocks}}" wx:key="id" wx:for-item="block"><view class="md-line {{block.type === 'list-item' ? 'md-item' : ''}}"><block wx:for="{{block.runs}}" wx:key="id" wx:for-item="run"><text wx:if="{{run.kind === 'link'}}" class="md-link" data-href="{{run.href}}" catchtap="copyLink">{{run.text}}</text><rich-text wx:else nodes="{{run.html}}"></rich-text></block></view></block></view></view>
      <view class="card section"><view class="section-head"><view class="rule-title">评价中的教师</view></view><view class="offering" wx:for="{{course.teacher_groups}}" wx:key="id"><view class="teacher-avatar">{{item.teacher_name_short}}</view><view class="offering-main"><view class="teacher-name">{{item.teacher_name}}</view><view class="micro">按网站评价中的教师名称分组</view></view><tag-chip text="{{item.review_count}} 条评价" tone="green"></tag-chip></view><view class="micro" wx:if="{{!course.teacher_groups.length}}">服务器评价中暂时没有教师信息</view></view>
      <view class="card section"><view class="rule-title">服务器标签</view><view class="tag-list"><tag-chip wx:for="{{course.tags}}" wx:key="*this" text="{{item}}"></tag-chip></view></view>
      <view class="card section" wx:if="{{course.contributors.length}}"><view class="rule-title">课程贡献者</view><view class="tag-list"><tag-chip wx:for="{{course.contributors}}" wx:key="*this" text="{{item}}"></tag-chip></view></view>
      <view class="notice section"><view class="notice-mark">i</view><text>课程分类、学期、标签与评价直接来自服务器；缺失字段不会由小程序臆造。</text></view>
    </view>
  </block>
</view>