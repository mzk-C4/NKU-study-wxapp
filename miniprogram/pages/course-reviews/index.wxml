<view class="reviews-page">
  <view class="detail-tabs"><view class="detail-tab" data-tab="overview" bindtap="openTab">概览</view><view class="detail-tab" data-tab="resources" bindtap="openTab">资料 {{course.resource_count || 0}}</view><view class="detail-tab detail-tab--active">评价 {{course.review_count || 0}}</view></view>
  <view class="page reviews-body">
    <view class="card score-card" wx:if="{{course}}"><view class="score-number">{{filteredRatings.show_aggregate ? filteredRatings.recommend : '—'}}</view><view class="score-copy"><view class="score-label">{{filteredRatings.show_aggregate ? '综合感受' : '评价样本不足'}}</view><view class="micro">基于当前筛选的 {{visibleReviews.length}} 条已发布评价；不足 3 条不展示综合分</view></view><view class="score-bars"><view><text>难度</text><b>{{filteredRatings.difficulty || '—'}}</b></view><view><text>作业量</text><b>{{filteredRatings.workload || '—'}}</b></view><view><text>收获</text><b>{{filteredRatings.gain || '—'}}</b></view></view></view>
    <view class="card review-filters section">
      <view class="filter-head"><view class="rule-title">筛选评价</view><text wx:if="{{hasActiveFilters}}" bindtap="clearFilters">清除</text></view>
      <view class="filter-grid">
        <picker range="{{teacherOptions}}" range-key="label" value="{{filterIndexes.teacher}}" data-field="teacher" bindchange="changeFilter"><view class="filter-picker"><text>教师</text><b>{{teacherFilterLabel}}</b></view></picker>
        <picker range="{{yearOptions}}" range-key="label" value="{{filterIndexes.year}}" data-field="year" bindchange="changeFilter"><view class="filter-picker"><text>学年</text><b>{{yearFilterLabel}}</b></view></picker>
        <picker range="{{semesterOptions}}" range-key="label" value="{{filterIndexes.semester}}" data-field="semester" bindchange="changeFilter"><view class="filter-picker"><text>学期</text><b>{{semesterFilterLabel}}</b></view></picker>
      </view>
    </view>
    <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleReviews.length}}" empty-text="还没有同学评价" bindretry="loadReviews"></state-view>
    <view class="review-card" wx:for="{{visibleReviews}}" wx:key="id"><view class="review-head"><view class="review-avatar">同</view><view class="review-user"><view>匿名同学</view><view class="micro">{{item.teacher_name}} · {{item.term_label}}</view></view><tag-chip text="已修读" tone="green"></tag-chip></view><view class="review-tags"><tag-chip wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" text="{{tag}}"></tag-chip></view><view class="review-body">{{item.body}}</view><view class="review-foot"><text>有帮助 {{item.helpful_count}}</text><text>举报</text></view></view>
    <view class="empty-space"></view>
  </view>
  <view class="sticky-footer"><button class="button button--primary" bindtap="writeReview">写课程评价</button></view>
</view>
