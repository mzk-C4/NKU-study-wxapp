<view class="reviews-page">
  <view class="detail-tabs"><view class="detail-tab" data-tab="overview" bindtap="openTab">概览</view><view class="detail-tab" data-tab="resources" bindtap="openTab">资料 {{course.resource_count || 0}}</view><view class="detail-tab detail-tab--active">评价 {{course.review_count || 0}}</view></view>
  <view class="page reviews-body">
    <view class="card score-card" wx:if="{{course}}"><view class="score-number">{{course.ratings.show_aggregate ? course.ratings.recommend : '—'}}</view><view class="score-copy"><view class="score-label">{{course.ratings.show_aggregate ? '综合感受' : '评价样本不足'}}</view><view class="micro">基于 {{course.review_count}} 条已发布评价</view></view><view class="score-bars"><view><text>难度</text><b>{{course.ratings.difficulty || '—'}}</b></view><view><text>作业量</text><b>{{course.ratings.workload || '—'}}</b></view><view><text>收获</text><b>{{course.ratings.gain || '—'}}</b></view></view></view>
    <view class="chips section"><view class="chip {{!offeringId ? 'chip--active' : ''}}" data-id="" bindtap="chooseOffering">全部教师</view><view wx:for="{{offerings}}" wx:key="id" class="chip {{offeringId === item.id ? 'chip--active' : ''}}" data-id="{{item.id}}" bindtap="chooseOffering">{{item.teacher_name}}</view></view>
    <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleReviews.length}}" empty-text="还没有同学评价" bindretry="loadReviews"></state-view>
    <view class="review-card" wx:for="{{visibleReviews}}" wx:key="id"><view class="review-head"><view class="review-avatar">同</view><view class="review-user"><view>匿名同学</view><view class="micro">{{item.teacher_name}} · {{item.term_label}}</view></view><tag-chip text="已修读" tone="green"></tag-chip></view><view class="review-tags"><tag-chip wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" text="{{tag}}"></tag-chip></view><view class="review-body">{{item.body}}</view><view class="review-foot"><text>有帮助 {{item.helpful_count}}</text><text>举报</text></view></view>
    <view class="empty-space"></view>
  </view>
  <view class="sticky-footer"><button class="button button--primary" bindtap="writeReview">写课程评价</button></view>
</view>
