<view class="reviews-page">
  <course-detail-tabs course-id="{{id}}" active="reviews" resource-count="{{course.resource_count || 0}}" review-count="{{course.review_count || 0}}"></course-detail-tabs>
  <view class="page reviews-body">
    <view class="card score-card" wx:if="{{course}}"><view class="score-number">{{course.ratings.show_aggregate ? course.ratings.average : '—'}}</view><view class="score-copy"><view class="score-label">{{course.ratings.show_aggregate ? '综合评分' : '暂无公开评分'}}</view><view class="micro">基于 {{course.ratings.count}} 条公开评价</view></view></view>
    <view class="chips section" wx:if="{{groups.length}}"><view class="chip {{!groupKey ? 'chip--active' : ''}}" data-key="" bindtap="chooseGroup">全部教师</view><view wx:for="{{groups}}" wx:key="group_key" class="chip {{groupKey === item.group_key ? 'chip--active' : ''}}" data-key="{{item.group_key}}" bindtap="chooseGroup">{{item.teacher_name}}</view></view>
    <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleReviews.length}}" empty-text="{{reviewEmptyText}}" bindretry="loadReviews"></state-view>
    <view class="review-card" wx:for="{{visibleReviews}}" wx:key="id"><view class="review-head"><view class="review-avatar">同</view><view class="review-user"><view>匿名同学</view><view class="micro">{{item.teacher_name}} · {{item.created_at || '时间未标注'}}</view></view><tag-chip wx:if="{{item.rating}}" text="{{item.rating}} 分" tone="green"></tag-chip></view><view class="review-tags"><tag-chip wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" text="{{tag}}"></tag-chip></view><view class="review-body">{{item.body}}</view><view class="review-foot"><text>有帮助 {{item.helpful_count}}</text><text bindtap="reportUnavailable">举报建设中</text></view></view>
    <view class="empty-space"></view>
  </view>
  <view class="sticky-footer"><button class="button button--primary" bindtap="writeReview">评价提交建设中</button></view>
</view>
