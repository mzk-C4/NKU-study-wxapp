<view class="reviews-page">
  <view class="detail-tabs" wx:if="{{course}}"><view class="detail-tab" data-tab="overview" bindtap="openTab">概览</view><view class="detail-tab" data-tab="resources" bindtap="openTab">资料 {{course.resource_count || 0}}</view><view class="detail-tab detail-tab--active">评价 {{course.review_count || 0}}</view></view>
  <view class="page reviews-body">
    <view class="card score-card" wx:if="{{course}}"><view class="score-number">{{course.ratings.show_aggregate ? course.ratings.average : '—'}}</view><view class="score-copy"><view class="score-label">{{course.ratings.show_aggregate ? '总体评分' : '评价样本不足'}}</view><view class="micro">基于 {{course.review_count}} 条已发布评价；沿用服务器单一评分</view></view></view>
    <view class="card score-card" wx:if="{{standaloneGroup && !course}}"><view class="score-number">{{standaloneGroup.rating_average || '—'}}</view><view class="score-copy"><view class="score-label">{{standaloneGroup.course_name}} · {{standaloneGroup.teacher_name}}</view><view class="micro">历史评价未匹配当前课程，按网站原分组正常展示</view></view></view>
    <view class="chips section"><view class="chip {{!teacher ? 'chip--active' : ''}}" data-teacher="" bindtap="chooseTeacher">全部教师</view><view wx:for="{{teacherGroups}}" wx:key="id" class="chip {{teacher === item.teacher_name ? 'chip--active' : ''}}" data-teacher="{{item.teacher_name}}" bindtap="chooseTeacher">{{item.teacher_name}}</view></view>
    <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !visibleReviews.length}}" empty-text="还没有同学评价" bindretry="loadReviews"></state-view>
    <view class="review-card" wx:for="{{visibleReviews}}" wx:key="id"><view class="review-head"><view class="review-avatar">匿</view><view class="review-user"><view>匿名同学 · {{item.rating}} 分</view><view class="micro">{{item.teacher_name}}</view></view><tag-chip text="已审核" tone="green"></tag-chip></view><view class="review-tags"><tag-chip wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" text="{{tag}}"></tag-chip></view><view class="review-body">{{item.body}}</view><view class="review-foot"><text>有帮助 {{item.helpful_count}}</text><text>{{item.created_at}}</text></view></view>
    <view class="empty-space"></view>
  </view>
  <view class="sticky-footer"><button class="button button--primary" bindtap="writeReview">{{course ? '写课程评价' : '该历史评价暂不可投稿'}}</button></view>
</view>
