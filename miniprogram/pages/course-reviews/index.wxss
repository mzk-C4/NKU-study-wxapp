.detail-tabs { display: grid; grid-template-columns: repeat(3, 1fr); height: 90rpx; background: var(--nk-surface, #FFFDF8); border-bottom: 1rpx solid var(--nk-line, #E8E2EC); }
.detail-tab { position: relative; display: flex; align-items: center; justify-content: center; color: var(--nk-muted, #6F6972); font-size: 24rpx; }
.detail-tab--active { color: var(--nk-accent, #4B1F6F); font-weight: 700; }
.detail-tab--active::after { content: ""; position: absolute; left: 34%; right: 34%; bottom: 0; height: 6rpx; background: var(--nk-primary, #4B1F6F); }
.score-card { display: flex; align-items: center; gap: 20rpx; }
.score-number { color: var(--nk-accent, #4B1F6F); font-family: Georgia, serif; font-size: 72rpx; font-weight: 700; }
.score-copy { flex: 1; }.score-label { margin-bottom: 6rpx; font-weight: 700; }
.stars { display: flex; align-items: center; gap: 4rpx; }.stars--summary { margin: 5rpx 0 9rpx; }.star { color: #DED7E2; font-size: 27rpx; line-height: 1; }.star--active { color: var(--nk-gold, #D7A63C); text-shadow: 0 1rpx 0 rgba(75,31,111,.18); }.stars--summary .star { font-size: 34rpx; }
.score-bars { width: 160rpx; color: var(--nk-muted, #6F6972); font-size: 20rpx; }.score-bars view { display: flex; justify-content: space-between; margin: 7rpx 0; }.score-bars b { color: var(--nk-accent, #4B1F6F); }
.review-filters { padding: 24rpx; }.filter-head { display: flex; align-items: center; justify-content: space-between; }.filter-head > text { color: var(--nk-accent, #6B3A8E); font-size: 22rpx; }.filter-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }.filter-picker { min-width: 0; padding: 18rpx 14rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 18rpx; background: var(--nk-soft, #F8F5F9); }.filter-picker text, .filter-picker b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.filter-picker text { color: var(--nk-muted, #817A84); font-size: 19rpx; }.filter-picker b { margin-top: 7rpx; color: var(--nk-accent, #4B1F6F); font-size: 22rpx; }
.review-card { margin-top: 20rpx; padding: 26rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 26rpx; background: var(--nk-surface, #FFFDF8); }
.review-head { display: flex; align-items: flex-start; gap: 16rpx; flex-wrap: wrap; }
.review-score { flex: none; width: 84rpx; min-height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 20rpx; color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #EFE8F4); }
.review-score-value { font-size: 34rpx; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }
.review-score-caption { margin-top: 4rpx; font-size: 18rpx; line-height: 1.3; }
.review-user { flex: 1; min-width: 100rpx; padding-top: 6rpx; }
.review-teacher { color: var(--nk-text, #2B123E); font-size: 26rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.review-user .stars { margin-top: 8rpx; }
.review-user .star { font-size: 22rpx; }
.review-date { flex: none; margin-left: auto; padding-top: 8rpx; color: var(--nk-muted, #6F6972); font-size: 20rpx; line-height: 1.5; white-space: nowrap; font-variant-numeric: tabular-nums; }
.review-content { display: flex; align-items: center; gap: 20rpx; margin-top: 20rpx; }
.review-body { flex: 1; min-width: 0; color: var(--nk-text, #484248); font-size: 25rpx; line-height: 1.75; overflow-wrap: anywhere; }
.helpful-button { flex: none; width: 88rpx !important; max-width: 88rpx; min-height: 108rpx; margin: 0 !important; padding: 12rpx 4rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 20rpx; color: var(--nk-muted, #6F6972); background: transparent; box-sizing: border-box; line-height: 1.3; }
.helpful-button--active { border-color: var(--nk-accent, #4B1F6F); color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #EFE8F4); }
.helpful-button[disabled] { opacity: .55; }
.helpful-icon { width: 30rpx; height: 30rpx; }
.helpful-count { font-size: 24rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.helpful-caption { font-size: 18rpx; }
.review-compose-fab { position: fixed; z-index: 10; right: 32rpx; bottom: calc(28rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; align-items: center; justify-content: center; width: 112rpx !important; min-width: 112rpx; max-width: 112rpx; height: 112rpx; margin: 0 !important; padding: 0; border: 2rpx solid rgba(255,255,255,.3); border-radius: 50%; color: #FFFFFF; background: var(--nk-primary, #4B1F6F); box-shadow: 0 6rpx 18rpx rgba(43,18,62,.2); font-size: 22rpx; line-height: 1.2; }
.compose-icon { font-size: 38rpx; line-height: 1; margin-bottom: 4rpx; }
.reviews-body { padding-bottom: calc(172rpx + env(safe-area-inset-bottom)); }
.reviews-body .empty-space { height: 0; }

/* Fixed glyph box keeps decimal and half stars aligned with the empty star. */
.star { position: relative; display: block; width: 1em; height: 1em; flex: none; }
.star > text, .star-fill > text { display: block; width: 1em; height: 1em; line-height: 1; }
.star-fill { position: absolute; top: 0; left: 0; height: 100%; overflow: hidden; color: var(--nk-gold, #D7A63C); }
