page { height:100%; background:#FFFEFC; }
.map-page { position:fixed; top:0; right:0; bottom:0; left:0; overflow:hidden; display:flex; flex-direction:column; color:#2B174A; padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; }
button::after { border:0; }
.map-toolbar { flex-shrink:0; padding:20rpx 28rpx 0; }
.campus-tabs { display:flex; gap:16rpx; }
.campus-tab { width:0 !important; min-width:0; flex:1; margin:0 !important; font-size:28rpx; line-height:80rpx; border-radius:20rpx; background:#F1EDF4; color:#65596D; }
.active { background:#7650A5; color:#fff; }
.map-search { margin-top:18rpx; height:80rpx; padding:0 24rpx; background:#F5F2F7; border-radius:18rpx; font-size:28rpx; }
.category-scroll { width:100%; margin:16rpx 0; }
.category-row { display:flex; gap:12rpx; }
.category-chip { width:auto !important; min-width:0; max-width:none; white-space:nowrap; flex:0 0 auto; margin:0 !important; padding:0 24rpx; font-size:25rpx; line-height:76rpx; border-radius:38rpx; background:#F1EDF4; color:#65596D; }
.category-chip.active { background:#7650A5; color:#fff; }
.map-area { flex:1 1 0; min-height:100rpx; position:relative; overflow:hidden; background:#F1EDF4; }
.campus-map { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; }
.map-reset { position:absolute; right:24rpx; top:24rpx; padding:22rpx; background:#fff; color:#7650A5; border-radius:12rpx; font-size:24rpx; }
.places-panel, .detail-panel { flex-shrink:0; padding:20rpx 28rpx; background:#FFFEFC; box-sizing:border-box; }
.panel-title { font-size:28rpx; font-weight:700; padding-bottom:12rpx; }
.count { margin-left:14rpx; color:#81748C; font-size:24rpx; font-weight:400; }
.places-list { height:260rpx; }
.place-row { display:flex; align-items:center; width:100% !important; margin:0 !important; padding:18rpx 0; background:transparent; border-bottom:1rpx solid #EFEAF2; text-align:left; line-height:1.5; border-radius:0; }
.place-info { flex:1; min-width:0; }
.place-name { font-size:28rpx; color:#2B174A; }
.place-desc { color:#716A7D; font-size:23rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.arrow { padding-left:20rpx; color:#7650A5; font-size:40rpx; }
.map-note, .image-caption { color:#81748C; font-size:22rpx; padding-top:12rpx; }
.map-credit { flex-shrink:0; padding:12rpx 28rpx; background:#F1EDF4; color:#65596D; font-size:22rpx; line-height:1.5; }
.empty { padding:40rpx 0; color:#716A7D; font-size:26rpx; }
.detail-heading { display:flex; align-items:center; gap:16rpx; }
.detail-title { font-size:32rpx; font-weight:700; }
.detail-category { font-size:23rpx; color:#7650A5; margin-top:8rpx; }
.close { flex-shrink:0; width:80rpx !important; margin:0 !important; padding:0; line-height:80rpx; background:#F1EDF4; color:#65596D; border-radius:50%; }
.detail-content { height:180rpx; margin:14rpx 0; }
.detail-description { font-size:26rpx; line-height:1.7; color:#65596D; }
.place-image { width:100%; border-radius:16rpx; margin-top:16rpx; }
.navigate { width:100% !important; margin:0 !important; background:#7650A5; color:#fff; line-height:84rpx; border-radius:18rpx; font-size:28rpx; }

.map-error { position:absolute; left:20rpx; right:20rpx; bottom:20rpx; padding:20rpx; background:#FFF7E7; color:#76562B; font-size:24rpx; line-height:36rpx; white-space:normal; }

.map-reload { position:absolute; left:24rpx; top:24rpx; padding:22rpx; background:#fff; color:#7650A5; border-radius:12rpx; font-size:24rpx; }
.place-modes, .detail-tools { display:flex; align-items:center; gap:12rpx; margin-bottom:12rpx; }
.place-mode, .detail-tool, .empty-action { width:auto !important; margin:0 !important; padding:0 20rpx; min-height:64rpx; font-size:24rpx; line-height:64rpx; color:#4B1F6F; background:#F1EDF4; border-radius:16rpx; }
.chosen { color:#fff; background:#4B1F6F; }
.detail-tools { margin-top:12rpx; }
.detail-content--expanded { height:30vh; max-height:380rpx; }
.favorite-mark { display:inline-block; padding:2rpx 10rpx; font-size:20rpx; color:#4B1F6F; background:#EFE8F4; border-radius:8rpx; }
.empty-action { margin-top:12rpx !important; display:inline-block; }
.storage-note { padding:8rpx 28rpx; }
.count { font-variant-numeric:tabular-nums; }
