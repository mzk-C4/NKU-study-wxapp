<view class="map-page">
  <view class="map-toolbar">
    <view class="campus-tabs"><button wx:for="{{campusOptions}}" wx:key="id" class="campus-tab {{campusId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeCampus">{{item.label}}校区</button></view>
    <input class="map-search" value="{{query}}" placeholder="搜索建筑、食堂、学院…" maxlength="80" bindinput="search" aria-label="搜索校园地点" />
    <scroll-view class="category-scroll" scroll-x enhanced><view class="category-row"><button wx:for="{{categoryOptions}}" wx:key="value" class="category-chip {{category === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="changeCategory">{{item.label}}</button></view></scroll-view>
  </view>
  <view class="map-area">
    <map id="campus-map" class="campus-map" longitude="{{longitude}}" latitude="{{latitude}}" scale="{{scale}}" markers="{{markers}}" bindmarkertap="selectMarker" bindcallouttap="selectMarker" enable-zoom enable-scroll />
    <cover-view class="map-reset" bindtap="resetMap">校区全景</cover-view>
  </view>
  <view class="places-panel" wx:if="{{!selected}}">
    <view class="panel-title">校园地点 <text class="count">{{places.length}} 处</text></view>
    <scroll-view class="places-list" scroll-y enhanced>
      <button wx:for="{{places}}" wx:key="id" class="place-row" data-id="{{item.markerId}}" bindtap="selectPlace"><view class="place-info"><view class="place-name">{{item.name}}</view><view class="place-desc">{{item.categoryLabel}} · {{item.desc}}</view></view><text class="arrow">›</text></button>
      <view wx:if="{{!places.length}}" class="empty">没有找到地点，试试其他关键词或分类</view>
    </scroll-view>
    <view class="map-note">学生共建点位 · 请以现场标识为准</view>
  </view>
  <view wx:else class="detail-panel">
    <view class="detail-heading"><view class="place-info"><view class="detail-title">{{selected.name}}</view><view class="detail-category">{{selected.categoryLabel}}</view></view><button class="close" bindtap="closeDetail" aria-label="关闭地点详情">×</button></view>
    <scroll-view class="detail-content" scroll-y><view class="detail-description">{{selected.desc}}</view><view wx:for="{{selected.images}}" wx:key="src"><image class="place-image" src="{{item.src}}" mode="widthFix" data-src="{{item.src}}" bindtap="previewImage" /><view class="image-caption">{{item.caption}}</view></view></scroll-view>
    <button class="navigate" bindtap="navigate">去这里 · 打开导航</button>
  </view>
</view>
