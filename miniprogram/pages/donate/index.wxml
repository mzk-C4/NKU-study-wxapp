<view class="page">
  <view class="card website-card">
    <view class="website-title">NKUStudy 网站</view>
    <view class="website-description">复制链接，在浏览器中打开网站。</view>
    <text class="website-url" user-select="{{true}}">{{websiteUrl}}</text>
    <button class="button button--primary section" loading="{{copying}}" disabled="{{copying}}" bindtap="copyWebsite">{{copied ? '再次复制网站链接' : '复制网站链接'}}</button>
    <view wx:if="{{copied}}" class="website-description" aria-live="polite">链接已复制，请在浏览器地址栏粘贴并打开。</view>
    <view wx:if="{{copyError}}" class="notice section" aria-live="polite">{{copyError}}</view>
  </view>
</view>
