.resource-icon { width: 116rpx; height: 128rpx; margin: 12rpx auto 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 30rpx; color: #4B1F6F; background: #EFE8F4; font-size: 24rpx; font-weight: 700; }
.resource-name { text-align: center; font-size: 34rpx; line-height: 1.45; font-weight: 700; }.resource-course { margin-top: 10rpx; text-align: center; color: #6F6972; font-size: 21rpx; }
.info-list { padding: 0 26rpx; }.info-row { min-height: 88rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #E8E2EC; font-size: 23rpx; }.info-row:last-child { border-bottom: 0; }.info-row > text { color: #6F6972; }
.button + .button { margin-top: 16rpx; }.small-title { font-size: 28rpx; }.related { display: flex; gap: 18rpx; align-items: center; padding: 20rpx 0; border-top: 1rpx solid #E8E2EC; }.related-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; color: #4B1F6F; background: #EFE8F4; font-size: 15rpx; font-weight: 700; }.related-title { font-size: 24rpx; font-weight: 700; }
.unavailable-card { margin-top: 40rpx; text-align: center; }.unavailable-text { margin-top: 22rpx; color: #6F6972; font-size: 24rpx; line-height: 1.7; }
