.profile-hero { margin: 24rpx 24rpx 0; padding: 36rpx 30rpx 30rpx; color: #FFFFFF; background: var(--nk-primary, #4B1F6F); border: 1rpx solid var(--nk-accent, #62417B); border-radius: 32rpx; }
.profile-row { display: flex; gap: 24rpx; align-items: center; }
.profile-copy { min-width: 0; flex: 1; }
.profile-avatar { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; overflow: hidden; box-sizing: border-box; border: 6rpx solid rgba(255,255,255,.24); border-radius: 50%; color: var(--nk-accent, #4B1F6F); background: var(--nk-gold-soft, #F6EACD); font-family: Georgia, serif; font-size: 50rpx; font-weight: 700; }
.profile-avatar-image { width: 100%; height: 100%; border-radius: 50%; }
.profile-avatar-button { min-width: 120rpx; max-width: 120rpx; margin: 0; padding: 0; line-height: 1; }
.profile-avatar-button::after { border: 0; }
.profile-avatar-button[disabled] { opacity: .7; }
.avatar-status { margin-top: 18rpx; color: #F6EACD; font-size: 22rpx; line-height: 1.6; }
.avatar-preview-note { font-weight: 700; }
.avatar-draft-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.avatar-action { margin: 0; padding: 12rpx 24rpx; min-height: 64rpx; border-radius: 18rpx; color: #FFFFFF; background: rgba(255,255,255,.14); font-size: 23rpx; line-height: 1.5; }
.avatar-action::after { border: 0; }
.profile-eyebrow { margin-bottom: 10rpx; color: var(--nk-gold, #E8CF96); font-size: 18rpx; letter-spacing: 2rpx; }
.profile-name { font-size: 32rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.profile-sub { margin-top: 10rpx; color: rgba(255,255,255,.78); font-size: 22rpx; line-height: 1.6; }
.login-button { width: 100% !important; min-width: 100%; max-width: 100%; min-height: 88rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 24rpx 0 0 !important; padding: 22rpx 28rpx; border-radius: 44rpx; color: var(--nk-text, #3B1B50); background: var(--nk-gold-soft, #F6EACD); font-size: 27rpx; font-weight: 700; line-height: 1.5; }
.profile-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.hero-button { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: var(--nk-text, #2B123E); background: #D7A63C; font-size: 24rpx; font-weight: 700; padding: 0; margin: 0; line-height: 1; }.hero-button--quiet { color: #FFFFFF; background: rgba(255,255,255,.14); }
.profile-body { min-height: 0; padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.profile-body .section { margin-top: 24rpx; }
.profile-stats { display: flex; align-items: stretch; width: 100%; box-sizing: border-box; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 26rpx; background: var(--nk-surface, #FFFDF8); }
.profile-stat + .profile-stat { border-left: 1rpx solid var(--nk-line, #E8E2EC); }
.profile-stat:first-child { border-radius: 26rpx 0 0 26rpx; }
.profile-stat:last-child { border-radius: 0 26rpx 26rpx 0; }

.profile-stat text { display: block; width: 100%; margin-top: 8rpx; color: var(--nk-muted, #6F6972); font-size: 23rpx; line-height: 1.5; text-align: center; }

.menu { padding: 0 26rpx; }.menu-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--nk-line, #E8E2EC); font-size: 25rpx; }.menu-row:last-child { border-bottom: 0; }.record-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 14rpx; }.record-row--detail { align-items: flex-start; }.record-main { min-width: 0; flex: 1; }.history-name { margin-bottom: 6rpx; font-weight: 700; }.record-body { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: var(--nk-muted, #484248); font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.review-note { margin-top: 10rpx; color: var(--nk-gold, #8A5A12); font-size: 20rpx; }.status { flex: none; padding: 7rpx 12rpx; border-radius: 999rpx; color: var(--nk-muted, #6F6972); background: var(--nk-soft, #EEE9EF); font-size: 19rpx; }.status--approved, .status--published { color: var(--nk-green, #24613B); background: var(--nk-soft, #E1F2E6); }.status--pending { color: var(--nk-gold, #75510C); background: var(--nk-gold-soft, #F8ECCB); }.status--needs_changes, .status--rejected, .status--hidden { color: var(--nk-red, #8B3131); background: var(--nk-red-soft, #F7E1E1); }.empty-record { color: var(--nk-muted, #817A84); text-align: center; font-size: 22rpx; }.section-action { color: var(--nk-accent, #6B3A8E); font-size: 22rpx; }.profile-note { margin-top: 30rpx; text-align: center; color: var(--nk-muted, #817A84); font-size: 20rpx; line-height: 1.6; }
.about-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(28, 16, 40, .55); }
.about-sheet { width: 100%; max-height: 78vh; padding: 34rpx 34rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 40rpx 40rpx 0 0; background: var(--nk-surface, #FFFDF8); }
.about-head { display: flex; align-items: center; justify-content: space-between; }
.about-title { color: var(--nk-text, #2B123E); font-size: 32rpx; font-weight: 700; }
.about-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--nk-muted, #817A84); background: var(--nk-soft, #F0EBF2); font-size: 34rpx; line-height: 1; }
.about-lead { margin-top: 18rpx; color: var(--nk-accent, #4B1F6F); font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.about-block { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--nk-line, #EDE6EF); }
.about-label { color: var(--nk-gold, #8A5A12); font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.about-text { margin-top: 8rpx; color: var(--nk-muted, #484248); font-size: 24rpx; line-height: 1.7; }
.about-foot { margin-top: 26rpx; color: var(--nk-muted, #817A84); text-align: center; font-size: 20rpx; line-height: 1.6; }
.profile-field { margin-top: 28rpx; }
.feedback-sheet { max-height: 86vh; }.feedback-option { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 26rpx; background: var(--nk-surface, #FAF7FB); }.feedback-option-head { display: flex; align-items: center; gap: 18rpx; }.feedback-icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 20rpx; color: var(--nk-text, #2B123E); background: #D7A63C; font-size: 25rpx; font-weight: 800; }.feedback-icon--github { color: #FFFFFF; background: var(--nk-primary, #4B1F6F); font-size: 19rpx; }.feedback-title { color: var(--nk-text, #2B123E); font-size: 26rpx; font-weight: 700; }.feedback-desc { margin-top: 5rpx; color: var(--nk-muted, #817A84); font-size: 20rpx; line-height: 1.5; }.feedback-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }.feedback-button { min-width: 0; flex: 1; margin: 0; }.feedback-copy { min-width: 150rpx; height: 78rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid var(--nk-line, #CFC3D5); border-radius: 20rpx; color: var(--nk-accent, #4B1F6F); background: var(--nk-surface, #FFFFFF); font-size: 22rpx; line-height: 78rpx; }.feedback-tip { margin-top: 22rpx; padding: 20rpx; border-radius: 20rpx; color: var(--nk-muted, #6F6972); background: var(--nk-soft, #F3EEF5); font-size: 20rpx; line-height: 1.6; }

.learning-card { padding: 28rpx 26rpx; box-sizing: border-box; }
.learning-header { display: flex; flex-direction: column; align-items: flex-start; gap: 14rpx; }
.learning-title { color: var(--nk-text, #2B123E); font-size: 29rpx; font-weight: 700; line-height: 1.4; }
.learning-copy,
.learning-help { color: var(--nk-muted, #746E79); font-size: 21rpx; line-height: 1.55; }
.learning-copy { margin-top: 8rpx; }
.learning-status {
  max-width: 100%;
  padding: 10rpx 16rpx;
  border-radius: 24rpx;
  color: var(--nk-accent, #5B2A7A);
  background: var(--nk-soft, #F2ECF7);
  font-size: 20rpx;
  line-height: 1.45;
  text-align: left;
  word-break: break-all;
  box-sizing: border-box;
}
.learning-summary-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: start;
  min-height: 74rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--nk-line, #EEE8F1);
  box-sizing: border-box;
}
.learning-header + .learning-summary-row { margin-top: 20rpx; }
.learning-summary-label { color: var(--nk-muted, #6F6972); font-size: 24rpx; }
.learning-summary-value { color: var(--nk-text, #2B123E); font-size: 24rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.learning-form { margin-top: 24rpx; }
.learning-field + .learning-field { margin-top: 28rpx; }
.learning-label { color: var(--nk-text, #2B123E); font-size: 25rpx; font-weight: 700; line-height: 1.45; }
.learning-help { margin-top: 8rpx; }
.learning-input {
  width: 100%;
  min-height: 84rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--nk-line, #D9D1DE);
  border-radius: 18rpx;
  color: var(--nk-text, #2B123E);
  background: var(--nk-surface, #FFFDFC);
  font-size: 25rpx;
  line-height: 84rpx;
  box-sizing: border-box;
}
.learning-input--error { border-color: var(--nk-red, #B42318); }
.learning-error { margin-top: 10rpx; color: var(--nk-red, #B42318); font-size: 22rpx; line-height: 1.5; }
.learning-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 26rpx; }
.learning-primary-button,
.learning-secondary-button,
.learning-clear-button {
  min-width: 220rpx;
  min-height: 82rpx;
  flex: 1 1 220rpx;
  margin: 0 !important;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
  box-sizing: border-box;
}
.learning-primary-button { color: #FFFFFF; background: var(--nk-primary, #5B2A7A); }
.learning-secondary-button { color: var(--nk-muted, #4B4550); background: var(--nk-soft, #F1EDF3); }
.learning-clear-button { color: var(--nk-red, #B42318); background: var(--nk-soft, #FFF2F0); border: 1rpx solid var(--nk-line, #E7B7B1); }
.learning-button--pressed { opacity: .74; }

.phone-verify-button { margin: 0; padding: 6rpx 24rpx; font-size: 0.8em; line-height: 1.6; background: var(--nk-primary, #4B1F6F); color: #fff; border-radius: 999rpx; }
.theme-settings-head { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.theme-options { display:flex; gap:18rpx; margin:22rpx 0 12rpx; }
.theme-option { flex:1; width:0 !important; min-width:0; min-height:84rpx; margin:0; padding:16rpx; line-height:1.6; font-size:26rpx; border-radius:18rpx; color:var(--nk-text, #211C24); background:var(--nk-soft, #EFE8F4); border:2rpx solid var(--nk-line, #E8E2EC); }
.theme-option--selected { color:#FFFFFF; background:var(--nk-primary, #4B1F6F); border-color:var(--nk-accent, #4B1F6F); font-weight:700; }
/* Gold branded buttons retain dark lettering rather than a light theme token. */
.hero-button:not(.hero-button--quiet) { color:#2B123E; }

.profile-stat { flex: 1 1 0%; width: 0 !important; min-width: 0 !important; max-width: none; min-height: 132rpx; margin: 0 !important; padding: 22rpx 6rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 0; border-radius: 0; background: transparent; line-height: 1.5; box-sizing: border-box; }
.profile-stat::after { border: 0; }
.profile-stat .profile-stat-value { margin-top: 0; color: var(--nk-accent, #4B1F6F); font-size: 36rpx; font-weight: 700; font-variant-numeric: tabular-nums; }

.profile-stat--pressed { background: var(--nk-soft, #EFE8F4); }
