.profile-hero { padding: 34rpx 32rpx 38rpx; color: #FFFFFF; background: #4B1F6F; border-radius: 0 0 48rpx 48rpx; }.profile-row { display: flex; gap: 22rpx; align-items: center; }.profile-copy { min-width: 0; flex: 1; }.profile-avatar { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 34rpx; color: #4B1F6F; background: #D7A63C; font-size: 42rpx; font-weight: 700; }.profile-name { font-size: 34rpx; font-weight: 700; }.profile-sub { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 21rpx; line-height: 1.5; }
.login-button, .logout-button { margin-top: 24rpx; height: 78rpx; line-height: 78rpx; border-radius: 20rpx; color: #2B123E; background: #D7A63C; font-size: 25rpx; font-weight: 700; }.logout-button { color: #FFFFFF; background: rgba(255,255,255,.14); }
.profile-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.hero-button { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #2B123E; background: #D7A63C; font-size: 24rpx; font-weight: 700; padding: 0; margin: 0; line-height: 1; }.hero-button--quiet { color: #FFFFFF; background: rgba(255,255,255,.14); }
.profile-stats { display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; border: 1rpx solid #E8E2EC; border-radius: 26rpx; background: #E8E2EC; gap: 1rpx; }.profile-stats view { padding: 24rpx 8rpx; display: flex; flex-direction: column; align-items: center; background: #FFFDF8; }.profile-stats b { color: #4B1F6F; font-size: 34rpx; }.profile-stats text { margin-top: 6rpx; color: #6F6972; font-size: 20rpx; }
.menu { padding: 0 26rpx; }.menu-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #E8E2EC; font-size: 25rpx; }.menu-row:last-child { border-bottom: 0; }.record-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 14rpx; }.record-row--detail { align-items: flex-start; }.record-main { min-width: 0; flex: 1; }.history-name { margin-bottom: 6rpx; font-weight: 700; }.record-body { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: #484248; font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.review-note { margin-top: 10rpx; color: #8A5A12; font-size: 20rpx; }.status { flex: none; padding: 7rpx 12rpx; border-radius: 999rpx; color: #6F6972; background: #EEE9EF; font-size: 19rpx; }.status--approved, .status--published { color: #24613B; background: #E1F2E6; }.status--pending { color: #75510C; background: #F8ECCB; }.status--needs_changes, .status--rejected, .status--hidden { color: #8B3131; background: #F7E1E1; }.empty-record { color: #817A84; text-align: center; font-size: 22rpx; }.section-action { color: #6B3A8E; font-size: 22rpx; }.profile-note { margin-top: 30rpx; text-align: center; color: #817A84; font-size: 20rpx; line-height: 1.6; }
.about-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(28, 16, 40, .55); }
.about-sheet { width: 100%; max-height: 78vh; padding: 34rpx 34rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; border-radius: 40rpx 40rpx 0 0; background: #FFFDF8; }
.about-head { display: flex; align-items: center; justify-content: space-between; }
.about-title { color: #2B123E; font-size: 32rpx; font-weight: 700; }
.about-close { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #817A84; background: #F0EBF2; font-size: 34rpx; line-height: 1; }
.about-lead { margin-top: 18rpx; color: #4B1F6F; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.about-block { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #EDE6EF; }
.about-label { color: #8A5A12; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.about-text { margin-top: 8rpx; color: #484248; font-size: 24rpx; line-height: 1.7; }
.about-foot { margin-top: 26rpx; color: #817A84; text-align: center; font-size: 20rpx; line-height: 1.6; }
.profile-field { margin-top: 28rpx; }
.feedback-sheet { max-height: 86vh; }.feedback-option { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #E8E2EC; border-radius: 26rpx; background: #FAF7FB; }.feedback-option-head { display: flex; align-items: center; gap: 18rpx; }.feedback-icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 20rpx; color: #2B123E; background: #D7A63C; font-size: 25rpx; font-weight: 800; }.feedback-icon--github { color: #FFFFFF; background: #4B1F6F; font-size: 19rpx; }.feedback-title { color: #2B123E; font-size: 26rpx; font-weight: 700; }.feedback-desc { margin-top: 5rpx; color: #817A84; font-size: 20rpx; line-height: 1.5; }.feedback-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }.feedback-button { min-width: 0; flex: 1; margin: 0; }.feedback-copy { min-width: 150rpx; height: 78rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #CFC3D5; border-radius: 20rpx; color: #4B1F6F; background: #FFFFFF; font-size: 22rpx; line-height: 78rpx; }.feedback-tip { margin-top: 22rpx; padding: 20rpx; border-radius: 20rpx; color: #6F6972; background: #F3EEF5; font-size: 20rpx; line-height: 1.6; }
