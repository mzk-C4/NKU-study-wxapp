.profile-hero { padding: 34rpx 32rpx 38rpx; color: #FFFFFF; background: #4B1F6F; border-radius: 0 0 48rpx 48rpx; }.profile-row { display: flex; gap: 22rpx; align-items: center; }.profile-avatar { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; color: #4B1F6F; background: #D7A63C; font-size: 42rpx; font-weight: 700; }.profile-name { font-size: 34rpx; font-weight: 700; }.profile-sub { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }
.login-button, .logout-button { margin-top: 24rpx; height: 78rpx; line-height: 78rpx; border-radius: 20rpx; color: #2B123E; background: #D7A63C; font-size: 25rpx; font-weight: 700; }.logout-button { color: #FFFFFF; background: rgba(255,255,255,.14); }
.profile-stats { display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; border: 1rpx solid #E8E2EC; border-radius: 26rpx; background: #E8E2EC; gap: 1rpx; }.profile-stats view { padding: 24rpx 8rpx; display: flex; flex-direction: column; align-items: center; background: #FFFDF8; }.profile-stats b { color: #4B1F6F; font-size: 34rpx; }.profile-stats text { margin-top: 6rpx; color: #6F6972; font-size: 20rpx; }
.menu { padding: 0 26rpx; }.menu-row { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #E8E2EC; font-size: 25rpx; }.menu-row:last-child { border-bottom: 0; }.history-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }.history-name { margin-bottom: 6rpx; font-weight: 700; }.profile-note { margin-top: 30rpx; text-align: center; color: #817A84; font-size: 20rpx; line-height: 1.6; }
