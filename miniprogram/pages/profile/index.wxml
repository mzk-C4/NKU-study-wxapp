<view class="profile-page">
  <view class="profile-hero"><view class="profile-row"><view class="profile-avatar">N</view><view><view class="profile-name">你好，南开同学</view><view class="profile-sub">浏览课程、资料和评价无需登录</view></view></view><button class="login-button" loading="{{loading}}" bindtap="login">手机号登录建设中</button></view>
  <view class="page profile-body">
    <view class="profile-stats"><view><b>{{history.length}}</b><text>本机浏览</text></view><view><b>—</b><text>收藏课程</text></view><view><b>—</b><text>我的贡献</text></view></view>
    <view class="card menu section"><view class="menu-row" bindtap="unavailable"><text>我的收藏</text><text class="muted">{{favoriteLabel}} ›</text></view><view class="menu-row" bindtap="openSubmit"><text>我的投稿</text><text class="muted">{{submissionLabel}} ›</text></view><view class="menu-row" bindtap="unavailable"><text>我的评价</text><text class="muted">{{reviewLabel}} ›</text></view></view>
    <view class="section" wx:if="{{history.length}}"><view class="section-head"><view class="section-title">最近浏览</view></view><view class="card history-row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="openHistory"><view><view class="history-name">{{item.name}}</view><view class="micro">{{item.group || '分类待补充'}} · {{item.term || '学期待补充'}}</view></view><text>›</text></view></view>
    <view class="card menu section"><view class="menu-row" bindtap="feedback"><text>意见反馈</text><text>›</text></view><view class="menu-row" bindtap="about"><text>关于 NKUStudy</text><text>›</text></view></view>
    <view class="profile-note"><view>微信手机号登录仅保留未来框架，当前不会发起登录请求</view><view>学生共建 · 非南开大学官方平台</view></view>
  </view>
</view>
