<view class="profile-page">
  <view class="profile-hero"><view class="profile-row"><view class="profile-avatar">N</view><view><view class="profile-name">{{user ? 'NKUStudy 用户' : '你好，南开同学'}}</view><view class="profile-sub">{{user ? '已登录 · 公开页面保持匿名' : '浏览无需登录，登录后同步收藏和投稿'}}</view></view></view><button wx:if="{{!user}}" class="login-button" loading="{{loading}}" bindtap="login">微信登录</button><button wx:else class="logout-button" bindtap="logout">退出登录</button></view>
  <view class="page profile-body">
    <view class="profile-stats"><view><b>{{history.length}}</b><text>本机浏览</text></view><view><b>{{user ? favorites.length : '—'}}</b><text>收藏课程</text></view><view><b>{{user ? contributionCount : '—'}}</b><text>我的贡献</text></view></view>
    <view class="card menu section">
      <view class="menu-row" data-section="favorites" bindtap="toggleSection"><text>我的收藏</text><text class="muted">{{favoriteLabel}} {{expandedSection === 'favorites' ? '⌃' : '›'}}</text></view>
      <view class="menu-row" data-section="history" bindtap="toggleSection"><text>浏览历史</text><text class="muted">本机 {{history.length}} 条 {{expandedSection === 'history' ? '⌃' : '›'}}</text></view>
      <view class="menu-row" data-section="submissions" bindtap="toggleSection"><text>我的投稿</text><text class="muted">{{submissionLabel}} {{expandedSection === 'submissions' ? '⌃' : '›'}}</text></view>
      <view class="menu-row" data-section="reviews" bindtap="toggleSection"><text>我的评价</text><text class="muted">{{reviewLabel}} {{expandedSection === 'reviews' ? '⌃' : '›'}}</text></view>
    </view>
    <view class="record-section section" wx:if="{{expandedSection === 'favorites'}}"><view class="section-head"><view class="section-title">我的收藏</view></view><view class="card record-row" wx:for="{{favorites}}" wx:key="id" data-id="{{item.id}}" bindtap="openFavorite"><view><view class="history-name">{{item.name}}</view><view class="micro">{{item.category_code}}区 · {{item.department}}</view></view><text>›</text></view><view class="card empty-record" wx:if="{{!favorites.length}}">还没有收藏课程</view></view>
    <view class="record-section section" wx:if="{{expandedSection === 'history'}}"><view class="section-head"><view class="section-title">最近浏览</view></view><view class="card record-row" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" bindtap="openHistory"><view><view class="history-name">{{item.name}}</view><view class="micro">{{item.category_code}}区 · {{item.department}}</view></view><text>›</text></view><view class="card empty-record" wx:if="{{!history.length}}">本机还没有浏览记录</view></view>
    <view class="record-section section" wx:if="{{expandedSection === 'submissions'}}"><view class="section-head"><view class="section-title">我的投稿</view><text class="section-action" bindtap="openSubmit">继续投稿</text></view><view class="card record-row record-row--detail" wx:for="{{submissions}}" wx:key="id"><view class="record-main"><view class="history-name">{{item.title}}</view><view class="micro">{{item.course_name}} · {{item.type}}</view><view class="review-note" wx:if="{{item.review_note}}">审核说明：{{item.review_note}}</view></view><text class="status status--{{item.status}}">{{item.status_label}}</text></view><view class="card empty-record" wx:if="{{!submissions.length}}">还没有资料投稿</view></view>
    <view class="record-section section" wx:if="{{expandedSection === 'reviews'}}"><view class="section-head"><view class="section-title">我的评价</view></view><view class="card record-row record-row--detail" wx:for="{{reviews}}" wx:key="id" data-id="{{item.course_id}}" bindtap="openReview"><view class="record-main"><view class="history-name">{{item.course_name}}</view><view class="micro">{{item.teacher_name}} · {{item.term_label}}</view><view class="record-body">{{item.body}}</view><view class="review-note" wx:if="{{item.review_note}}">审核说明：{{item.review_note}}</view></view><text class="status status--{{item.status}}">{{item.status_label}}</text></view><view class="card empty-record" wx:if="{{!reviews.length}}">还没有提交评价</view></view>
    <view class="card menu section"><view class="menu-row" bindtap="feedback"><text>意见反馈</text><text>›</text></view><view class="menu-row" bindtap="about"><text>关于 NKUStudy</text><text>›</text></view></view>
    <view class="profile-note"><view>无需实名，不公开微信信息</view><view>学生共建 · 非南开大学官方平台</view></view>
  </view>
</view>
