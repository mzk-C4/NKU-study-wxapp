.search-row { width: 100%; }
.search-input { width: 100%; padding-right: 12rpx; }
.search-input input { flex: 1; min-width: 0; height: 100%; }
.search-clear { flex: 0 0 64rpx; width: 64rpx !important; min-width: 64rpx; max-width: 64rpx; height: 64rpx; min-height: 64rpx; margin: 0 !important; padding: 0; border: 0; border-radius: 50%; color: #6F6972; background: #E8E2EC; font-size: 38rpx; font-weight: 400; line-height: 64rpx; text-align: center; }
.search-clear--pressed { opacity: .65; }
.search-clear::after, .active-filter::after, .reset-filters::after, .result-card::after, .load-more-retry::after { border: 0; }
.filter-panel { padding: 22rpx; border: 1rpx solid #E8E2EC; border-radius: 24rpx; background: #FFFFFF; }
.filter-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.filter-title { color: #312C34; font-size: 26rpx; font-weight: 700; }
.reset-filters { min-height: 72rpx; margin: 0; padding: 0 10rpx; border: 0; color: #4B1F6F; background: transparent; font-size: 22rpx; line-height: 72rpx; }
.filters { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 14rpx; }
.filter-picker { min-width: 0; }
.filter { min-width: 0; min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 12rpx 16rpx; border: 1rpx solid #E8E2EC; border-radius: 18rpx; color: #5F5962; background: #FFFDF8; font-size: 22rpx; line-height: 32rpx; text-align: center; word-break: break-all; box-sizing: border-box; }
.filter--active { border-color: #4B1F6F; color: #4B1F6F; font-weight: 700; }
.active-filters { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.active-filter { width: auto; min-height: 72rpx; margin: 0; padding: 10rpx 18rpx; border: 1rpx solid #E8E2EC; border-radius: 18rpx; color: #4B1F6F; background: #FFFDF8; font-size: 21rpx; line-height: 30rpx; text-align: left; word-break: break-all; }
.control--pressed { opacity: .65; }
.search-idle { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 60rpx 24rpx; color: #817A84; text-align: center; }
.state-title { color: #312C34; font-size: 30rpx; font-weight: 700; }
.state-text { font-size: 23rpx; line-height: 1.6; }
.result-card { width: 100% !important; min-width: 100%; max-width: 100%; display: flex; align-self: stretch; gap: 18rpx; align-items: flex-start; margin: 0 0 20rpx !important; padding: 26rpx; border: 1rpx solid #E8E2EC; border-radius: 26rpx; color: #312C34; background: #FFFDF8; line-height: normal; text-align: left; box-sizing: border-box; }
.result-card--pressed { opacity: .72; }
.result-zone { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 18rpx; color: #FFFFFF; background: #4B1F6F; font-size: 20rpx; font-weight: 700; }
.result-main { flex: 1; min-width: 0; }
.result-name { display: block; margin-bottom: 8rpx; font-size: 30rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.match-note { display: block; margin-top: 12rpx; color: #6F6872; font-size: 22rpx; line-height: 1.5; word-break: break-all; }
.result-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.result-arrow { color: #817A84; font-size: 44rpx; }
.load-more { padding: 30rpx 0 10rpx; text-align: center; color: #817A84; font-size: 22rpx; }
.load-more-retry { min-height: 80rpx; margin: 10rpx auto 0; padding: 0 24rpx; border: 0; color: #4B1F6F; background: transparent; font-size: 22rpx; line-height: 80rpx; }
