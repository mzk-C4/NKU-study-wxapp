.search-row { display: flex; align-items: center; gap: 16rpx; }
.search-input { flex: 1; }
.search-input input { flex: 1; height: 100%; }
.cancel { color: #4B1F6F; font-size: 24rpx; font-weight: 700; }
.type-tabs { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 18rpx; border-bottom: 1rpx solid #E8E2EC; }
.type-tab { position: relative; padding: 24rpx 0 18rpx; text-align: center; color: #6F6972; font-size: 23rpx; }
.type-tab--active { color: #4B1F6F; font-weight: 700; }
.type-tab--active::after { content: ""; position: absolute; left: 35%; right: 35%; bottom: 0; height: 6rpx; border-radius: 3rpx; background: #4B1F6F; }
.result-card { display: flex; gap: 18rpx; align-items: flex-start; margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid #E8E2EC; border-radius: 26rpx; background: #FFFDF8; }
.result-zone { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 18rpx; color: #FFFFFF; background: #4B1F6F; font-size: 20rpx; font-weight: 700; }
.result-main { flex: 1; min-width: 0; }
.result-name { display: block; margin-bottom: 8rpx; font-size: 30rpx; font-weight: 700; }
.result-tags { display: flex; gap: 8rpx; margin-top: 12rpx; }
.result-arrow { color: #817A84; font-size: 44rpx; }
