<view class="page review-form-page">
  <state-view loading="{{loading}}" error="{{error}}" bindretry="prepare"></state-view>
  <block wx:if="{{!loading && !error}}">
    <view class="micro muted" wx:if="{{hint}}" style="margin: 8px 0;">{{hint}}</view>

    <!-- 课程搜索选课 -->
    <view class="section field">
      <text class="field-label">课程</text>
      <view class="search-box search-input" style="margin-bottom: 8px;">
        <view class="search-icon"></view>
        <input value="{{courseKeyword}}" maxlength="120" placeholder="搜索课程名或输入新课程名" confirm-type="search" bindinput="inputCourse" />
        <button wx:if="{{courseKeyword}}" class="search-clear" hover-class="search-clear--pressed" aria-label="清除" bindtap="clearCourse">×</button>
      </view>
      <view wx:if="{{selectedCourse}}" class="card selected-course" style="margin: 0 0 8px;">
        <view class="course-zone">{{selectedCourse.type === 'manifest' ? '课程库' : '手册'}}</view>
        <view><view class="selected-name">{{selectedCourse.name}}</view><view class="micro">已选择，可点击 × 重新搜索</view></view>
      </view>
      <view wx:if="{{courseResults.length && !selectedCourse}}" class="course-search-results">
        <view wx:for="{{courseResults}}" wx:key="id" class="card course-result-row" data-type="{{item.type}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="chooseCourse">
          <view class="course-zone">{{item.type === 'manifest' ? '课程库' : '手册'}}</view>
          <view><view class="result-name">{{item.name}}</view><view class="micro" wx:if="{{item.sub}}">{{item.sub}}</view></view>
          <text>›</text>
        </view>
      </view>
      <view wx:if="{{courseKeyword && !courseResults.length && !selectedCourse}}" class="micro muted">
        {{allowCustomCourse ? '未找到匹配课程，可直接使用当前输入提交' : '未找到匹配课程，请调整关键词或从结果中选择'}}
      </view>
    </view>

    <!-- 教师 -->
    <view class="section field">
      <text class="field-label">任课教师</text>
      <block wx:if="{{strictTeacher}}">
        <view class="tag-options" wx:if="{{teacherOptions.length}}">
          <view wx:for="{{teacherOptions}}" wx:key="*this" class="chip {{teacher === item ? 'chip--active' : ''}}" data-teacher="{{item}}" bindtap="chooseTeacher">{{item}}</view>
        </view>
        <view wx:else class="field-hint">该课程暂无教师名单，可直接输入</view>
        <input wx:if="{{!teacherOptions.length}}" class="input" maxlength="100" placeholder="请输入教师姓名" value="{{teacher}}" bindinput="inputTeacher"/>
      </block>
      <block wx:else>
        <input class="input" maxlength="100" placeholder="请输入教师姓名" value="{{teacher}}" bindinput="inputTeacher"/>
        <view class="tag-options" wx:if="{{teacherOptions.length}}">
          <view wx:for="{{teacherOptions}}" wx:key="*this" class="chip {{teacher === item ? 'chip--active' : ''}}" data-teacher="{{item}}" bindtap="chooseTeacher">{{item}}</view>
        </view>
      </block>
    </view>

    <!-- 评分 -->
    <view class="card section">
      <view class="rule-title">总体评分</view>
      <view class="rating-row"><text>课程体验</text><view class="rating-dots"><view wx:for="{{scoreOptions}}" wx:for-item="score" wx:key="*this" class="rating-dot {{rating >= score ? 'rating-dot--active' : ''}}" data-score="{{score}}" bindtap="setRating"></view></view><b>{{rating || '—'}}</b></view>
    </view>

    <!-- 评价内容 -->
    <view class="field section">
      <text class="field-label">评价内容</text>
      <textarea class="textarea review-textarea" maxlength="800" placeholder="说说课堂节奏、考核方式和学习建议" value="{{body}}" bindinput="inputBody"></textarea>
    </view>

    <view class="anonymous-row"><view><view class="anonymous-title">匿名发布</view><view class="micro">公开页面不会显示微信信息</view></view><switch color="#4B1F6F" checked="{{anonymous}}" bindchange="toggleAnonymous"></switch></view>
    <button class="button button--primary section" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交评价</button>
  </block>
</view>
