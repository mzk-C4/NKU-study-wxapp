<view class="page review-form-page">
  <state-view loading="{{loading}}" error="{{error}}" bindretry="prepare"></state-view>
  <block wx:if="{{course}}">
    <view class="card selected-course"><view class="course-zone">{{course.group}}</view><view><view class="selected-name">{{course.name}}</view><view class="micro">沿用网站方式：教师名称直接填写</view></view></view>
    <view class="section field"><text class="field-label">任课教师</text><input class="input" maxlength="100" placeholder="请输入教师姓名" value="{{teacher}}" bindinput="inputTeacher"/><view class="tag-options" wx:if="{{course.teacher_groups.length}}"><view wx:for="{{course.teacher_groups}}" wx:key="id" class="chip {{teacher === item.teacher_name ? 'chip--active' : ''}}" data-teacher="{{item.teacher_name}}" bindtap="chooseTeacher">{{item.teacher_name}}</view></view></view>
    <view class="card section"><view class="rule-title">总体评分</view><view class="rating-hint">点击星星评分，1 星表示很差，5 星表示很棒</view><view class="rating-row"><view class="rating-stars" role="radiogroup" aria-label="课程体验评分"><view wx:for="{{scoreOptions}}" wx:for-item="score" wx:key="*this" class="rating-star {{rating >= score ? 'rating-star--active' : ''}}" data-score="{{score}}" bindtap="setRating" role="radio" aria-checked="{{rating === score}}" aria-label="{{score}} 星">★</view></view><view class="rating-value {{rating ? 'rating-value--selected' : ''}}">{{rating ? rating + ' 分' : '请选择'}}</view></view></view>
    <view class="section" wx:if="{{tagOptions.length}}"><text class="field-label">选择已有印象标签（选填）</text><view class="tag-options"><view wx:for="{{tagOptions}}" wx:key="text" class="chip {{item.selected ? 'chip--active' : ''}}" data-tag="{{item.text}}" bindtap="toggleTag">{{item.text}}</view></view></view>
    <view class="field section"><text class="field-label">评价内容</text><textarea class="textarea review-textarea" maxlength="800" placeholder="说说课堂节奏、考核方式和学习建议（至少 20 字）" value="{{body}}" bindinput="inputBody"></textarea></view>
    <view class="anonymous-row"><view><view class="anonymous-title">匿名发布</view><view class="micro">公开页面不会显示微信信息</view></view><switch color="#4B1F6F" checked="{{anonymous}}" bindchange="toggleAnonymous"></switch></view>
    <button class="button button--primary section" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交审核</button>
  </block>
</view>
