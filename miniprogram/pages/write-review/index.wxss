.selected-course { display: flex; gap: 18rpx; align-items: center; }.course-zone { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #FFFFFF; background: #4B1F6F; font-weight: 700; }.selected-name { margin-bottom: 5rpx; font-size: 28rpx; font-weight: 700; }.picker { display: flex; align-items: center; justify-content: space-between; color: #211C24; }
.rule-title { padding-left: 16rpx; border-left: 8rpx solid #D7A63C; font-size: 30rpx; font-weight: 700; }.rating-row { display: grid; grid-template-columns: 120rpx 1fr 32rpx; gap: 14rpx; align-items: center; min-height: 72rpx; border-bottom: 1rpx solid #E8E2EC; font-size: 22rpx; }.rating-row:last-child { border-bottom: 0; }.rating-dots { display: flex; gap: 10rpx; }.rating-dot { width: 30rpx; height: 30rpx; border: 4rpx solid #D7A63C; border-radius: 50%; box-sizing: border-box; }.rating-dot--active { background: #D7A63C; }.tag-options { display: flex; flex-wrap: wrap; gap: 14rpx; }.review-textarea { min-height: 210rpx; }.anonymous-row { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; }.anonymous-title { font-weight: 700; }
.unavailable-card { margin-top: 40rpx; text-align: center; }.unavailable-text { margin-top: 22rpx; color: #6F6972; font-size: 24rpx; line-height: 1.7; }
