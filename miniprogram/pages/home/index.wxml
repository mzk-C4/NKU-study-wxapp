<view class="home">
  <view class="brand-row"><image class="brand-logo" src="/assets/brand.png" mode="aspectFill"></image><view><view class="brand-name">NKUStudy</view><view class="brand-sub">课程资料与选课参考</view></view></view>
  <view class="hero">
    <view class="hero-kicker">南开学生共建</view>
    <view class="hero-title">选课前，先来查一查</view>
    <view class="search-box" bindtap="openSearch"><view class="search-icon"></view><text>搜索课程、教师或关键词</text></view>
  </view>

  <view class="quick-grid">
    <view class="quick-item" data-url="/pages/courses/index" bindtap="openPage">
      <view class="quick-icon quick-icon--purple"><text class="quick-icon-text">课</text></view>
      <text class="quick-label">找课程</text>
    </view>
    <view class="quick-item" data-url="/pages/courses/index" bindtap="openPage">
      <view class="quick-icon quick-icon--gold"><text class="quick-icon-text">资</text></view>
      <text class="quick-label">找资料</text>
    </view>
    <view class="quick-item" data-url="/pages/courses/index" bindtap="openPage">
      <view class="quick-icon quick-icon--green"><text class="quick-icon-text">评</text></view>
      <text class="quick-label">看评价</text>
    </view>
    <view class="quick-item" data-url="/pages/guides/index" bindtap="openPage">
      <view class="quick-icon quick-icon--red"><text class="quick-icon-text">指</text></view>
      <text class="quick-label">选课指南</text>
    </view>
  </view>

  <state-view loading="{{loading}}" error="{{error}}" bindretry="loadHome"></state-view>
  <block wx:if="{{!loading && !error && home}}">
    <view class="season-card section" bindtap="openPage" data-url="/pages/guides/index">
      <view class="season-title">选课季 · 开始前先确认</view>
      <view class="season-text">小程序指南建设中，请以教务系统最新通知为准</view><view class="season-mark">选</view>
    </view>
    <view class="section">
      <view class="section-head"><view class="section-title">大家在看</view><view class="section-link" bindtap="openPage" data-url="/pages/courses/index">查看全部</view></view>
      <state-view wx:if="{{hotCourses.length === 0}}" empty="{{true}}" emptyText="暂时没有热门课程"></state-view>
      <course-card wx:for="{{hotCourses}}" wx:key="id" course="{{item}}" bindselect="openCourse"></course-card>
    </view>
    <view class="section" wx:if="{{latestUpdates.length}}">
      <view class="section-head"><view class="section-title">最近更新</view></view>
      <view class="card update-row" wx:for="{{latestUpdates}}" wx:key="id" data-id="{{item.id}}" bindtap="openUpdate">
        <view class="update-head">
          <view class="update-title">{{item.title}}</view>
          <view class="update-date" wx:if="{{item.updated}}">{{item.updated}}</view>
        </view>
        <view class="update-lead" wx:if="{{item.lead}}">{{item.lead}}</view>
        <view class="update-points" wx:if="{{item.hasPoints}}">
          <view class="update-point" wx:for="{{item.points}}" wx:key="id" wx:for-item="point"><view class="update-point-dot"></view><view class="update-point-text">{{point.text}}</view></view>
        </view>
        <view class="update-more">查看课程 ›</view>
      </view>
    </view>
    <view class="notice section" wx:if="{{home.announcement}}"><view class="notice-mark">i</view><text>{{home.announcement}}</text></view>
    <view class="build-note">学生共建 · 非南开大学官方平台</view>
  </block>
</view>
