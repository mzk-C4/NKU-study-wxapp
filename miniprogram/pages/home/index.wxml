<view class="home">
  <view class="brand-row"><image class="brand-logo" src="/assets/brand.png" mode="aspectFill"></image><view><view class="brand-name">NKUStudy</view><view class="brand-sub">课程资料与选课参考</view></view></view>
  <view class="hero">
    <view class="hero-kicker">南开学生共建</view>
    <view class="hero-title">选课前，先来查一查</view>
    <view class="search-box" bindtap="openSearch"><view class="search-icon"></view><text>搜索课程、教师或关键词</text></view>
  </view>

  <view class="quick-grid">
    <view class="quick" data-url="/pages/courses/index" bindtap="openPage"><view class="quick-icon">课</view><text>找课程</text></view>
    <view class="quick" data-url="/pages/search/index?type=course" bindtap="openPage"><view class="quick-icon quick-icon--gold">资</view><text>按课找资料</text></view>
    <view class="quick" data-url="/pages/search/index?type=course" bindtap="openPage"><view class="quick-icon quick-icon--green">评</view><text>查公开评价</text></view>
    <view class="quick" data-url="/pages/guides/index" bindtap="openPage"><view class="quick-icon quick-icon--red">指</view><text>选课指南</text></view>
  </view>

  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !hasPublicContent}}" empty-text="暂时没有可展示的公开内容" bindretry="loadHome"></state-view>
  <block wx:if="{{!loading && !error}}">
    <view class="notice section" wx:if="{{home.announcement}}"><view class="notice-mark">i</view><text>{{home.announcement}}</text></view>
    <view class="season-card section" bindtap="openPage" data-url="/pages/guides/index">
      <view class="season-title">选课指南建设中</view>
      <view class="season-text">暂未连接线上指南服务；选课规则请以教务系统最新通知为准</view><view class="season-mark">选</view>
    </view>
    <view class="section" wx:if="{{hotCourses.length}}">
      <view class="section-head"><view class="section-title">大家在看</view><view class="section-link" bindtap="openPage" data-url="/pages/courses/index">查看全部</view></view>
      <view class="course-list"><course-card wx:for="{{hotCourses}}" wx:key="id" course="{{item}}" bindselect="openCourse"></course-card></view>
    </view>
    <view class="section" wx:if="{{home.latest_updates.length}}">
      <view class="section-head"><view class="section-title">最近更新</view></view>
      <view class="card update-row" wx:for="{{home.latest_updates}}" wx:key="id"><view class="update-dot"></view><view><view class="update-title">{{item.title}}</view><view class="micro">{{item.summary}}</view></view></view>
    </view>
    <view class="build-note">学生共建 · 非南开大学官方平台</view>
  </block>
</view>
