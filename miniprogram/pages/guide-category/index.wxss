.category-page {
  min-height: 100vh;
  color: #17132A;
  background:
    radial-gradient(circle at 20% 15%, rgba(188, 161, 225, .15), transparent 28%),
    linear-gradient(180deg, #FFFEFC 0%, #FBF8FD 64%, #FFFEFC 100%);
  box-sizing: border-box;
}

button::after { border: 0; }

.category-nav {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: 104rpx 1fr 174rpx;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #ECE8F0;
  background: rgba(255, 254, 252, .97);
  box-sizing: border-box;
}

.category-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx !important;
  height: 88rpx;
  margin: 0 !important;
  padding: 0;
  background: transparent;
}

.back-arrow {
  width: 25rpx;
  height: 25rpx;
  border-left: 7rpx solid #2B1750;
  border-bottom: 7rpx solid #2B1750;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.category-nav-title { color: #0C0B14; font-size: 31rpx; font-weight: 750; text-align: center; }
.category-nav-space { min-width: 174rpx; }
.icon-pressed { opacity: .7; }

.category-content { padding: 54rpx 30rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.category-hero { display: flex; align-items: center; gap: 28rpx; padding: 0 10rpx 48rpx; }
.category-hero-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 28%, #FCF8FF, #EEE7F5);
}
.category-document-icon { position: relative; width: 72rpx; height: 94rpx; border-radius: 12rpx; background: linear-gradient(145deg, #9569D4, #6030A0); box-shadow: 0 12rpx 24rpx rgba(94, 48, 160, .18); }
.category-document-icon view { position: absolute; left: 16rpx; right: 16rpx; height: 7rpx; border-radius: 5rpx; background: #FDFBFF; }
.category-document-icon view:nth-child(1) { top: 25rpx; }
.category-document-icon view:nth-child(2) { top: 43rpx; }
.category-document-icon view:nth-child(3) { top: 61rpx; }
.category-trophy-icon { position: absolute; right: 18rpx; bottom: 27rpx; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 16rpx 16rpx 22rpx 22rpx; color: #FFFFFF; background: linear-gradient(145deg, #E6B647, #C68B1E); font-size: 35rpx; font-weight: 800; transform: rotate(-4deg); }
.category-hero-main { min-width: 0; flex: 1; }
.category-title { color: #17113D; font-size: 52rpx; font-weight: 800; line-height: 1.24; }
.category-description { margin-top: 16rpx; color: #332E40; font-size: 27rpx; line-height: 1.65; }
.category-count { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; color: #56319B; font-size: 24rpx; line-height: 1.3; }
.count-file-icon { position: relative; width: 25rpx; height: 30rpx; border: 3rpx solid #754AC3; border-radius: 4rpx; box-sizing: border-box; }
.count-file-icon::after { content: ''; position: absolute; right: -3rpx; top: -3rpx; width: 8rpx; height: 8rpx; border-left: 3rpx solid #754AC3; border-bottom: 3rpx solid #754AC3; background: #FFFEFC; }

.category-tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; margin: 0 0 52rpx; }
.category-tab { width: 100% !important; min-width: 0; height: 68rpx; margin: 0 !important; padding: 0 3rpx; border: 1rpx solid #E7E1EC; border-radius: 24rpx; color: #2B2741; background: #F9F7FA; font-size: 19rpx; line-height: 68rpx; white-space: nowrap; box-sizing: border-box; }
.category-tab--active { color: #FFFFFF; background: linear-gradient(115deg, #4E168D, #7C30C5); box-shadow: 0 8rpx 16rpx rgba(90, 37, 155, .17); font-weight: 700; }
.category-tab--pressed, .category-guide-card--pressed { opacity: .76; }

.category-guide-list { display: flex; flex-direction: column; gap: 24rpx; }
.category-guide-card { position: relative; display: flex; align-items: flex-start; width: 100% !important; min-width: 100%; margin: 0 !important; padding: 38rpx 30rpx 30rpx 34rpx; border: 1rpx solid #EAE5F0; border-radius: 26rpx; color: #17132A; background: rgba(255, 255, 255, .94); text-align: left; box-shadow: 0 8rpx 22rpx rgba(48, 31, 70, .055); box-sizing: border-box; }
.category-guide-number { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 66rpx; height: 66rpx; margin-right: 24rpx; border-radius: 50%; color: #512294; background: radial-gradient(circle at 30% 25%, #F4E9FF, #E0CEF7); font-size: 34rpx; font-weight: 750; }
.category-guide-main { min-width: 0; flex: 1; padding-right: 30rpx; }
.category-guide-title { color: #15131C; font-size: 32rpx; font-weight: 750; line-height: 1.42; }
.category-guide-preview { display: -webkit-box; overflow: hidden; margin-top: 20rpx; color: #373442; font-size: 25rpx; line-height: 1.75; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.category-guide-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; margin-top: 24rpx; }
.category-guide-source, .category-guide-scope { display: flex; align-items: center; min-height: 48rpx; padding: 0 14rpx; border: 1rpx solid #ECE6F2; border-radius: 13rpx; color: #4D4861; background: #FCFAFD; font-size: 21rpx; line-height: 1.35; box-sizing: border-box; }
.source-book-icon { position: relative; width: 25rpx; height: 24rpx; margin-right: 12rpx; border: 3rpx solid #7C49C2; border-radius: 4rpx; box-sizing: border-box; }
.source-book-icon::after { content: ''; position: absolute; left: 10rpx; top: -3rpx; width: 3rpx; height: 24rpx; background: #7C49C2; }
.scope-building-icon { position: relative; width: 24rpx; height: 22rpx; margin-right: 12rpx; border: 3rpx solid #7C49C2; border-top: 0; box-sizing: border-box; }
.scope-building-icon::before { content: ''; position: absolute; left: -5rpx; top: -10rpx; width: 26rpx; height: 10rpx; border: 3rpx solid #7C49C2; border-bottom: 0; transform: skewY(-24deg); box-sizing: border-box; }
.category-guide-arrow { position: absolute; right: 24rpx; top: 50%; color: #4F168D; font-size: 60rpx; font-weight: 300; transform: translateY(-45%); }

.category-more-note { display: flex; align-items: center; gap: 25rpx; min-height: 112rpx; padding: 22rpx 28rpx; border: 2rpx dashed #DCD2E9; border-radius: 24rpx; color: #514C63; background: rgba(255,255,255,.46); font-size: 23rpx; line-height: 1.55; box-sizing: border-box; }
.more-file-icon { position: relative; flex: 0 0 auto; width: 48rpx; height: 56rpx; border: 3rpx solid #7A4AB8; border-radius: 8rpx; box-sizing: border-box; }
.more-file-icon view { position: absolute; right: -3rpx; top: -3rpx; width: 17rpx; height: 17rpx; border-left: 3rpx solid #7A4AB8; border-bottom: 3rpx solid #7A4AB8; background: #FFFEFC; }
.more-file-icon text { position: absolute; right: -16rpx; bottom: -10rpx; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; color: #FFFFFF; background: #57209A; font-size: 23rpx; line-height: 1; }

.category-trust-bar { display: flex; align-items: center; gap: 13rpx; margin-top: 32rpx; padding: 20rpx 22rpx; border-radius: 18rpx; color: #514194; background: linear-gradient(100deg, #F6F1F9, #F4F0F8); font-size: 20rpx; line-height: 1.45; }
.trust-shield { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 28rpx; height: 30rpx; border: 2rpx solid #5C38AA; border-radius: 9rpx 9rpx 13rpx 13rpx; font-size: 18rpx; font-weight: 700; box-sizing: border-box; }
.trust-divider { width: 1rpx; height: 24rpx; margin: 0 4rpx; background: #C9BFDA; }
.category-student-note { margin: 28rpx 6rpx 0; color: #9C98AA; font-size: 19rpx; line-height: 1.5; text-align: center; }
