<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" background-text-style="{{themeLoading}}"><navigation-bar front-color="{{themeFront}}" background-color="{{themeNavigation}}" /></page-meta>
<view class="page">
  <view class="document-kicker">{{documentKey === 'cpp-notes' ? '学习笔记 · 按章阅读' : '外部文档 · 保留原文'}}</view>
  <view class="document-title">{{documentTitle}}</view>
  <view wx:if="{{localCppPreview}}" class="document-kicker">本地预览 · 尚未上线 · 重新编译后仍可阅读</view>
  <view class="document-intro">{{documentKey === 'cpp-notes' ? '按原文顺序阅读，保留代码、图表与作者署名。原始附件和最新修订可通过飞书原文查看。' : '生存手册图文已收录到学习指南针，此处保留飞书原文，便于核对最新内容和查看原始附件。'}}</view>
  <view wx:if="{{documentKey === 'cpp-notes'}}" class="notice section">作者：王昊成（小红书：秋来拾光），无所不能哈基咪。感谢作者分享！学习笔记仅供参考，请结合课程要求使用。</view>
  <view wx:else class="notice section">感谢参与本手册编写、整理与持续完善的各位学长！编写者署名与内容更新请以飞书原文为准。</view>
  <view wx:if="{{documentKey === 'cpp-notes'}}" class="section">
    <view class="document-label">阅读目录{{chapters.length ? ' · ' + chapters.length + ' 章' : ''}}</view>
    <view wx:if="{{chapterLoading}}" class="document-help">正在加载章节…</view>
    <view wx:elif="{{chapterError}}" class="document-error">{{chapterError}}<button bindtap="loadChapters">重新加载</button></view>
    <view wx:elif="{{!chapters.length}}" class="document-help">章节尚未上线，可先复制下方原文链接阅读。</view>
    <button wx:for="{{chapters}}" wx:key="id" class="chapter-row" data-id="{{item.id}}" bindtap="openChapter"><text class="chapter-number">{{index + 1}}</text><text>{{item.title}}</text><text class="chapter-arrow">›</text></button>
  </view>
  <view class="card section">
    <view class="document-label">原文链接</view>
    <text class="document-url" user-select="{{true}}">{{documentUrl}}</text>
    <button class="button button--primary document-copy" bindtap="copyLink" loading="{{copying}}" disabled="{{copying}}">{{copied ? '再次复制链接' : '复制原文链接'}}</button>
    <view class="document-success" wx:if="{{copied}}">链接已复制，请粘贴到浏览器中打开。</view>
    <view class="document-error" wx:if="{{copyError}}">{{copyError}}</view>
  </view>
  <view class="section document-help">
    <view class="document-label">打开说明</view>
    <view>1. 点击上方按钮复制原文链接。</view>
    <view>2. 在浏览器地址栏粘贴并打开。</view>
    <view>3. 如需登录或申请权限，请按照飞书页面提示操作。</view>
  </view>
  <view class="document-footnote">当前入口不在小程序内嵌打开飞书网页，也不会自动获得原文访问权限。</view>
</view>
