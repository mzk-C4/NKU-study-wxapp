.generating-dot {
  background: #7A35D1;
  opacity: .22;
  transform: scale(.82);
  animation: generating-dot-wave 1.5s ease-in-out infinite;
}
.generating-dot:nth-child(2) { animation-delay: .12s; }
.generating-dot:nth-child(3) { animation-delay: .24s; }
.generating-dot:nth-child(4) { animation-delay: .36s; }
.generating-dot:nth-child(5) { animation-delay: .48s; }
.generating-dot:nth-child(6) { animation-delay: .60s; }
.generating-dot:nth-child(7) { animation-delay: .72s; }
.generating-dot:nth-child(8) { animation-delay: .84s; }
.generating-dot:nth-child(9) { animation-delay: .96s; }
.generating-dot:nth-child(10) { animation-delay: 1.08s; }

@keyframes generating-dot-wave {
  0%, 58%, 100% { opacity: .22; transform: scale(.82); }
  18% { opacity: 1; transform: scale(1.16); }
}

.composer-notice {
  margin: 0 12rpx 12rpx;
  padding: 15rpx 20rpx;
  border: 1rpx solid #DCCEF2;
  border-radius: 18rpx;
  color: #4D1DA9;
  background: rgba(247, 242, 253, .98);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: anywhere;
}

@media (prefers-reduced-motion: reduce) {
  .generating-dot { animation: none; opacity: .58; transform: none; }
}

/* Shared safe answer Markdown blocks. */
.answer-markdown-heading { margin: 20rpx 0 12rpx; color: #242039; font-size: 28rpx; font-weight: 750; line-height: 1.45; }
.answer-markdown-list { display: flex; gap: 12rpx; margin: 0 0 12rpx; color: #343047; font-size: 27rpx; line-height: 1.75; }
.answer-markdown-list > text { color: #6A34B7; font-weight: 700; }
.answer-markdown-quote { margin: 16rpx 0; padding: 16rpx 20rpx; border-left: 6rpx solid #B99BE0; border-radius: 0 14rpx 14rpx 0; color: #423858; background: #F6F1FC; font-size: 27rpx; line-height: 1.75; }
.answer-markdown-link { display: inline; margin: 0; padding: 0; color: #59209E; background: transparent; font-size: inherit; text-decoration: underline; }
.answer-markdown-table-scroll { width: 100%; margin: 18rpx 0; white-space: nowrap; }
.answer-markdown-table { display: table; min-width: max-content; overflow: hidden; border: 1rpx solid #DED5E9; border-radius: 14rpx; background: #FFF; }
.answer-markdown-row { display: table-row; }
.answer-markdown-row--head { color: #42187C; background: #F0E8F8; font-weight: 700; }
.answer-markdown-cell { display: table-cell; min-width: 156rpx; padding: 16rpx 18rpx; border-right: 1rpx solid #E6DFED; border-bottom: 1rpx solid #E6DFED; color: #353043; font-size: 24rpx; line-height: 1.55; white-space: normal; vertical-align: top; }
