.assistant-page {
  min-height: 100vh;
  color: #101624;
  background:
    radial-gradient(circle at 82% 14%, rgba(119, 87, 180, .055), transparent 31%),
    linear-gradient(180deg, #FFFEFC 0%, #FBF9FC 42%, #FCFAFD 100%);
  box-sizing: border-box;
}

button::after { border: 0; }

.custom-nav {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: 104rpx 1fr 174rpx;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #F0ECF3;
  background: rgba(255, 254, 252, .98);
  box-sizing: border-box;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx !important;
  height: 88rpx;
  margin: 0 !important;
  padding: 0;
  color: #080B11;
  background: transparent;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 7rpx solid currentColor;
  border-bottom: 7rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.nav-title {
  overflow: hidden;
  color: #05070B;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.3;
  text-align: center;
  white-space: nowrap;
}

.nav-capsule-space { min-width: 174rpx; }

.assistant-content {
  min-height: calc(100vh - 96rpx);
  padding: 48rpx 28rpx 330rpx;
  box-sizing: border-box;
}

.question-state {
  position: relative;
  min-height: 336rpx;
  padding-left: 184rpx;
  box-sizing: border-box;
}

.question-bubble {
  min-height: 140rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  color: #111D55;
  background: linear-gradient(135deg, #F1ECFA 0%, #F8F5FB 100%);
  font-size: 28rpx;
  line-height: 1.75;
  box-sizing: border-box;
}

.retry-button {
  position: absolute;
  left: 104rpx;
  top: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx !important;
  min-width: 54rpx;
  height: 54rpx;
  margin: 0 !important;
  padding: 0;
  border-radius: 50%;
  color: #FFFFFF;
  background: linear-gradient(145deg, #8267DD, #6651CC);
  font-size: 38rpx;
  line-height: 1;
  box-shadow: 0 8rpx 18rpx rgba(102, 81, 204, .18);
}

.retry-button--loading { opacity: .62; }
.retry-button--pressed, .icon-pressed { opacity: .72; }

.question-tools {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 20rpx;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx !important;
  min-width: 54rpx;
  height: 54rpx;
  margin: 0 !important;
  padding: 0;
  color: #8A95B5;
  background: transparent;
  font-size: 38rpx;
  line-height: 1;
}

.copy-shape {
  position: relative;
  width: 26rpx;
  height: 30rpx;
  border: 3rpx solid #8A95B5;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.copy-shape view {
  position: absolute;
  left: -10rpx;
  top: 8rpx;
  width: 24rpx;
  height: 28rpx;
  border: 3rpx solid #8A95B5;
  border-radius: 5rpx;
  background: #FCFAFD;
  box-sizing: border-box;
}

.network-hint {
  margin-top: 8rpx;
  color: #7885AA;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: right;
}

.offline-empty, .building-state {
  padding: 74rpx 32rpx 42rpx;
  text-align: center;
}

.offline-title, .building-title {
  color: #18203B;
  font-size: 30rpx;
  font-weight: 700;
}

.offline-copy, .building-copy {
  margin-top: 14rpx;
  color: #7B84A0;
  font-size: 23rpx;
  line-height: 1.65;
}

.building-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: linear-gradient(145deg, #8267DD, #5C3FB7);
  font-size: 24rpx;
  font-weight: 700;
}

.continue-section { margin-top: 66rpx; }

.continue-title {
  margin-bottom: 18rpx;
  color: #12192B;
  font-size: 29rpx;
  font-weight: 700;
}

.continue-card {
  display: flex;
  align-items: center;
  width: 100% !important;
  min-height: 136rpx;
  margin: 0 0 20rpx !important;
  padding: 24rpx 24rpx 24rpx 26rpx;
  border: 2rpx solid #DDD5EB;
  border-radius: 22rpx;
  color: #111626;
  background: rgba(255, 255, 255, .9);
  text-align: left;
  line-height: 1.3;
  box-sizing: border-box;
}

.continue-card--pressed { background: #F5F0FA; }

.continue-icon {
  position: relative;
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  margin-right: 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #8158DE, #5932B0);
  box-shadow: 0 9rpx 20rpx rgba(92, 63, 183, .16);
}

.book-left, .book-right {
  position: absolute;
  top: 25rpx;
  width: 23rpx;
  height: 34rpx;
  background: #FFFFFF;
}

.book-left { left: 18rpx; border-radius: 5rpx 2rpx 9rpx 3rpx; }
.book-right { right: 18rpx; border-radius: 2rpx 5rpx 3rpx 9rpx; }

.search-ring {
  position: absolute;
  left: 22rpx;
  top: 20rpx;
  width: 35rpx;
  height: 35rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-ring::after {
  content: "";
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  width: 18rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
  transform: rotate(45deg);
}

.continue-main { min-width: 0; flex: 1; }
.continue-name { font-size: 28rpx; font-weight: 700; }
.continue-copy { margin-top: 9rpx; color: #657194; font-size: 22rpx; line-height: 1.45; }
.continue-arrow { flex: 0 0 auto; margin-left: 18rpx; color: #7E88A6; font-size: 50rpx; font-weight: 300; }

.composer-area {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(252,250,253,0), #FCFAFD 18%, #FCFAFD 100%);
  box-sizing: border-box;
}

.composer {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  padding: 20rpx 18rpx 20rpx 28rpx;
  border: 1rpx solid #EEEAF1;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(45, 28, 62, .09);
  box-sizing: border-box;
}

.composer-input {
  min-width: 0;
  height: 76rpx;
  flex: 1;
  color: #18203B;
  font-size: 25rpx;
  line-height: 76rpx;
}

.composer-placeholder { color: #8895BA; }

.attachment-button, .send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 0;
}

.attachment-button {
  width: 58rpx !important;
  min-width: 58rpx;
  height: 72rpx;
  color: #23304C;
  background: transparent;
}

.paperclip-icon {
  width: 18rpx;
  height: 38rpx;
  border: 4rpx solid #263451;
  border-top-color: transparent;
  border-radius: 0 0 15rpx 15rpx;
  transform: rotate(4deg);
  box-sizing: border-box;
}

.send-button {
  width: 68rpx !important;
  min-width: 68rpx;
  height: 68rpx;
  margin-left: 12rpx !important;
  border-radius: 50%;
  color: #FFFFFF;
  background: linear-gradient(145deg, #A487F0, #8A6EE8);
  font-size: 42rpx;
  line-height: 1;
}

.send-button[disabled] { opacity: .48; }
.send-button--pressed { transform: scale(.96); opacity: .85; }

.ai-note {
  margin-top: 20rpx;
  color: #7A86AD;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}
