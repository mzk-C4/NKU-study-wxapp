.progress { display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; }.progress-dot { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #817982; background: #EEE9F0; font-weight: 700; }.progress-dot--active { color: #FFFFFF; background: #4B1F6F; }.progress-line { width: 90rpx; height: 4rpx; background: #E8E2EC; }.picker { display: flex; align-items: center; justify-content: space-between; color: #6F6972; }.two-buttons button { margin: 0; }
