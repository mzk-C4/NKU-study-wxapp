<view class="guides-page">
  <view class="guide-intro">
    <view class="tower-mark" aria-hidden="true">
      <view class="tower-spire"></view>
      <view class="tower-roof"></view>
      <view class="tower-body"></view>
      <view class="tower-base"></view>
    </view>
    <image class="guide-logo" src="/assets/brand.png" mode="aspectFit"></image>
    <view class="guide-intro-main">
      <view class="guide-title">学习指南针</view>
      <view class="guide-sub">查找南开本科学习规则与办事流程</view>
      <view class="guide-trust"><view class="shield-mark">✓</view><text>学生共建 · 重要事项以最新官方文件为准</text></view>
    </view>
  </view>

  <view class="guide-body">
    <button class="guide-search" hover-class="control--pressed" aria-label="搜索学习指南" bindtap="openSearch">
      <view class="guide-search-icon"></view>
      <text>搜索选课、成绩、学籍、AI规范等问题</text>
    </button>

    <view class="assistant-card">
      <view class="assistant-mark" aria-hidden="true">
        <view class="assistant-face"><view class="assistant-eye assistant-eye--left"></view><view class="assistant-eye assistant-eye--right"></view><view class="assistant-smile"></view></view>
      </view>
      <view class="assistant-main">
        <view class="assistant-title">问问学习指南针</view>
        <view class="assistant-desc">基于已审核的学校文件回答，并附原文来源</view>
        <view class="assistant-context"><text class="context-person">●</text><text>{{guideContextLabel}}</text></view>
      </view>
      <button class="assistant-action" hover-class="assistant-action--pressed" aria-label="开始AI提问" bindtap="openAssistant">开始提问 <text>›</text></button>
    </view>

    <view class="category-panel" aria-label="指南一级分类">
      <button
        wx:for="{{homeCategories}}"
        wx:key="value"
        class="home-category {{activeHomeCategory === item.value ? 'home-category--active' : ''}}"
        hover-class="home-category--pressed"
        data-value="{{item.value}}"
        bindtap="openHomeCategory"
      >
        <view class="category-symbol category-symbol--{{item.tone}}">{{item.symbol}}</view>
        <text class="home-category-label">{{item.label}}</text>
        <view class="category-active-mark" wx:if="{{activeHomeCategory === item.value}}"></view>
      </button>
    </view>

    <view class="guide-section-head">
      <view class="guide-section-title">近期更新 <text class="new-mark" wx:if="{{guides.length}}">NEW</text></view>
      <button class="view-all" hover-class="control--pressed" bindtap="openAllGuides">查看全部 <text>›</text></button>
    </view>

    <state-view
      loading="{{loading}}"
      error="{{error}}"
      empty="{{isEmpty}}"
      empty-text="暂时没有已发布指南"
      bindretry="retry"
    >
      <view class="empty-help">普通搜索仍可使用，重要事项请以最新官方文件为准。</view>
    </state-view>

    <view class="guide-list" wx:if="{{!loading && !error && guides.length}}">
      <button
        wx:for="{{guides}}"
        wx:key="id"
        class="guide-row"
        data-id="{{item.id}}"
        bindtap="openGuide"
        hover-class="guide-row--pressed"
      >
        <view class="guide-fresh-dot" wx:if="{{index === 0}}"></view>
        <view class="guide-symbol guide-symbol--{{item.tone}}">{{item.symbol}}</view>
        <view class="guide-main">
          <view class="guide-name-line">
            <view class="guide-name">{{item.title}}</view>
            <text class="latest-mark" wx:if="{{index === 0}}">最新</text>
          </view>
          <view class="guide-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
          <view class="guide-bottom">
            <text class="guide-scope">适用：{{item.scope_label}}</text>
            <text class="guide-updated" wx:if="{{index === 0 && item.updated_label}}">{{item.updated_label}}</text>
          </view>
        </view>
        <view class="guide-arrow">›</view>
      </button>
    </view>

    <view class="load-more-state" wx:if="{{loadingMore}}">正在加载更多...</view>
    <view class="load-more-error" wx:elif="{{loadMoreError}}">
      <text>{{loadMoreError}}</text>
      <button class="load-more-button" bindtap="retryLoadMore">重试</button>
    </view>
    <view class="load-more-state" wx:elif="{{guides.length && !hasMore}}">已显示全部指南</view>

    <view class="guide-footnote">学生共建 · 重要事项以最新官方文件为准</view>
  </view>
</view>
