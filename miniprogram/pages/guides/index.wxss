.guide-hero { padding: 38rpx 32rpx 44rpx; color: #FFFFFF; background: #4B1F6F; border-radius: 0 0 48rpx 48rpx; }.guide-title { font-size: 46rpx; font-weight: 700; }.guide-sub { margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }
.guide-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }.guide-category { min-height: 140rpx; padding: 24rpx; border: 1rpx solid #E8E2EC; border-top: 6rpx solid #D7A63C; border-radius: 26rpx; background: #FFFDF8; box-sizing: border-box; }.guide-category--active { border-color: #4B1F6F; }.category-name { margin-bottom: 10rpx; font-size: 27rpx; font-weight: 700; }
.guide-list { padding: 0 26rpx; }.guide-row { display: flex; gap: 18rpx; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #E8E2EC; }.guide-row:last-child { border-bottom: 0; }.guide-index { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 16rpx; color: #4B1F6F; background: #EFE8F4; font-weight: 700; }.guide-main { flex: 1; }.guide-name { margin-bottom: 8rpx; font-size: 25rpx; font-weight: 700; }.guide-arrow { color: #817A84; font-size: 44rpx; }
.unavailable-card { margin-top: 12rpx; text-align: center; }.unavailable-text { margin-top: 22rpx; color: #6F6972; font-size: 24rpx; line-height: 1.7; }
