.guide-hero {
  padding: 38rpx 32rpx 44rpx;
  color: #FFFFFF;
  background: #4B1F6F;
  border-radius: 0 0 48rpx 48rpx;
}
.guide-title { font-size: 46rpx; font-weight: 700; }
.guide-sub { margin-top: 10rpx; color: rgba(255, 255, 255, .78); font-size: 22rpx; line-height: 1.55; }
.guide-updated { margin-top: 18rpx; color: rgba(255, 255, 255, .68); font-size: 20rpx; }
.guide-body { min-height: auto; }
.category-scroll { width: 100%; margin-bottom: 24rpx; }
.category-list { display: inline-flex; gap: 14rpx; padding: 2rpx; }
.category-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #E8E2EC;
  border-radius: 32rpx;
  color: #635D66;
  background: #FFFFFF;
  font-size: 23rpx;
  line-height: 72rpx;
}
.category-button--unavailable { color: #9D969F; background: #F2EFF3; }
.category-button--active { border-color: #4B1F6F; color: #FFFFFF; background: #4B1F6F; font-weight: 700; }
.guide-list { width: 100%; overflow: hidden; border: 1rpx solid #E8E2EC; border-radius: 26rpx; background: #FFFDF8; box-sizing: border-box; }
.guide-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100% !important;
  min-width: 100%;
  max-width: 100%;
  min-height: 156rpx;
  margin: 0 !important;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #E8E2EC;
  border-radius: 0;
  color: #211C24;
  background: transparent;
  text-align: left;
  line-height: 1.45;
  box-sizing: border-box;
}
.guide-row::after { border: 0; }
.guide-row:last-child { border-bottom: 0; }
.guide-row--pressed { background: #F5F0F7; }
.guide-main { min-width: 0; flex: 1; }
.guide-name { font-size: 29rpx; font-weight: 700; }
.guide-summary { margin-top: 10rpx; color: #5F5962; font-size: 23rpx; line-height: 1.55; }
.guide-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; color: #817A84; font-size: 20rpx; }
.guide-category-label { color: #4B1F6F; font-weight: 600; }
.guide-scope { margin-top: 8rpx; color: #817A84; font-size: 20rpx; }
.guide-arrow { flex: 0 0 auto; color: #817A84; font-size: 44rpx; }
.empty-help { max-width: 520rpx; color: #817A84; font-size: 22rpx; line-height: 1.6; text-align: center; }
.load-more-state { padding: 28rpx 0 8rpx; color: #817A84; font-size: 22rpx; text-align: center; }
.load-more-error { display: flex; align-items: center; justify-content: center; gap: 18rpx; padding-top: 24rpx; color: #817A84; font-size: 22rpx; }
.load-more-button { height: 72rpx; margin: 0; padding: 0 28rpx; border-radius: 36rpx; color: #4B1F6F; background: #EFE8F4; font-size: 22rpx; line-height: 72rpx; }

/* FB-18: 暗色模式 */
@media (prefers-color-scheme: dark) {
  .guide-hero { background: #2B123E; }
  .category-button { background: #211C28; border-color: #2D2838; color: #8B8090; }
  .category-button--unavailable { background: #1A1520; color: #4A4450; }
  .guide-list { background: #211C28; border-color: #2D2838; }
  .guide-row { color: #E0DCE4; border-bottom-color: #2D2838; }
  .guide-row--pressed { background: #2D2438; }
  .guide-summary { color: #A8A0B0; }
  .guide-meta { color: #8B8090; }
  .guide-category-label { color: #C9B8D8; }
  .guide-arrow { color: #8B8090; }
  .empty-help { color: #8B8090; }
  .load-more-state { color: #8B8090; }
  .load-more-error { color: #8B8090; }
  .load-more-button { background: #2D2438; color: #C9B8D8; }
}
