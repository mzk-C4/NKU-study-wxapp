.guides-page {
  min-height: 100vh;
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
  background: #FFFEFC;
  box-sizing: border-box;
}

.guide-intro {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-height: 228rpx;
  padding: 34rpx 34rpx 34rpx 32rpx;
  border-bottom: 1rpx solid #EFEAF2;
  background:
    radial-gradient(circle at 86% 18%, rgba(113, 72, 160, .08), transparent 35%),
    linear-gradient(135deg, #FFFDF8 0%, #FBF7FD 72%, #FFFFFF 100%);
  box-sizing: border-box;
}

.guide-logo {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  width: 132rpx;
  height: 132rpx;
}

.guide-intro-main {
  position: relative;
  z-index: 2;
  min-width: 0;
  flex: 1;
}

.guide-title {
  color: #2B174A;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.guide-sub {
  margin-top: 12rpx;
  color: #2E2931;
  font-size: 25rpx;
  line-height: 1.45;
}

.guide-trust {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
  color: #4C4653;
  font-size: 20rpx;
  line-height: 1.4;
}

.shield-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid #7650A5;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  color: #7650A5;
  font-size: 17rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.tower-mark {
  position: absolute;
  z-index: 1;
  right: 22rpx;
  bottom: -22rpx;
  width: 160rpx;
  height: 190rpx;
  opacity: .16;
}

.tower-spire {
  width: 3rpx;
  height: 42rpx;
  margin: 0 auto;
  background: #8B70AA;
}

.tower-roof {
  width: 88rpx;
  height: 20rpx;
  margin: 0 auto;
  border: 3rpx solid #8B70AA;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}

.tower-body {
  width: 62rpx;
  height: 106rpx;
  margin: 0 auto;
  border: 3rpx solid #8B70AA;
  background-image:
    linear-gradient(90deg, transparent 47%, rgba(139,112,170,.55) 48%, rgba(139,112,170,.55) 52%, transparent 53%),
    repeating-linear-gradient(0deg, transparent 0, transparent 18rpx, rgba(139,112,170,.42) 19rpx, rgba(139,112,170,.42) 22rpx);
  box-sizing: border-box;
}

.tower-base {
  width: 132rpx;
  height: 20rpx;
  margin: 0 auto;
  border: 3rpx solid #8B70AA;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}

.guide-body {
  padding: 28rpx 32rpx 20rpx;
  box-sizing: border-box;
}

.guide-search {
  display: flex;
  align-items: center;
  width: 100% !important;
  min-width: 100%;
  max-width: 100%;
  height: 94rpx;
  margin: 0 !important;
  padding: 0 30rpx;
  border: 2rpx solid #D7C9E6;
  border-radius: 48rpx;
  color: #716A7D;
  background: #FFFFFF;
  font-size: 25rpx;
  text-align: left;
  line-height: 1.4;
  box-sizing: border-box;
}

.guide-search::after,
.assistant-action::after,
.home-category::after,
.view-all::after,
.guide-row::after,
.load-more-button::after {
  border: 0;
}

.guide-search-icon {
  position: relative;
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  border: 5rpx solid #6C6580;
  border-radius: 50%;
  box-sizing: border-box;
}

.guide-search-icon::after {
  content: "";
  position: absolute;
  right: -13rpx;
  bottom: -8rpx;
  width: 17rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #6C6580;
  transform: rotate(45deg);
}

.control--pressed {
  opacity: .82;
}

.assistant-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 184rpx;
  margin-top: 30rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #E7DDED;
  border-radius: 28rpx;
  background: linear-gradient(110deg, #FBF5FD 0%, #F5ECFA 100%);
  box-shadow: 0 10rpx 28rpx rgba(64, 37, 86, .08);
  box-sizing: border-box;
}

.assistant-mark {
  position: relative;
  flex: 0 0 auto;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #7135A4, #4B1F6F);
  box-shadow: 0 10rpx 22rpx rgba(75,31,111,.18);
}

.assistant-mark::after {
  content: "";
  position: absolute;
  left: 11rpx;
  bottom: -8rpx;
  width: 0;
  height: 0;
  border-top: 24rpx solid #542078;
  border-right: 28rpx solid transparent;
}

.assistant-face {
  position: absolute;
  left: 19rpx;
  top: 18rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.assistant-eye {
  position: absolute;
  top: 18rpx;
  width: 6rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #5B287D;
}

.assistant-eye--left { left: 15rpx; }
.assistant-eye--right { right: 15rpx; }

.assistant-smile {
  position: absolute;
  left: 16rpx;
  top: 28rpx;
  width: 24rpx;
  height: 14rpx;
  border-bottom: 4rpx solid #5B287D;
  border-radius: 0 0 22rpx 22rpx;
}

.assistant-main {
  min-width: 0;
  flex: 1;
}

.assistant-title {
  color: #211C24;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
  white-space: nowrap;
}

.assistant-desc {
  margin-top: 7rpx;
  color: #6B6372;
  font-size: 18rpx;
  line-height: 1.45;
}

.assistant-context {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid #E1D6E8;
  border-radius: 18rpx;
  color: #4D4655;
  background: rgba(255,255,255,.52);
  font-size: 20rpx;
  line-height: 1.35;
  box-sizing: border-box;
}

.context-person {
  color: #542078;
  font-size: 16rpx;
}

.assistant-action {
  flex: 0 0 auto;
  width: 150rpx !important;
  min-width: 150rpx;
  max-width: 150rpx;
  height: 66rpx;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6B2D95, #4B1F6F);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 66rpx;
  box-shadow: 0 10rpx 22rpx rgba(75,31,111,.16);
}

.assistant-action--pressed,
.home-category--pressed,
.guide-row--pressed {
  opacity: .84;
}

.category-panel {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-top: 28rpx;
  padding: 18rpx 10rpx 12rpx;
  border: 1rpx solid #EEE9F1;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(52,35,68,.07);
  box-sizing: border-box;
}

.home-category {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1 1 0;
  width: 20% !important;
  min-width: 0;
  max-width: 20%;
  min-height: 142rpx;
  margin: 0 !important;
  padding: 8rpx 0 18rpx !important;
  border-radius: 20rpx;
  color: #29242D;
  background: transparent;
  line-height: 1.2;
  box-sizing: border-box;
}

.home-category--active {
  background: linear-gradient(180deg, rgba(245,238,250,.88), rgba(255,255,255,.2));
}

.category-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 19rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1;
}

.category-symbol--purple { color: #622B8D; background: #F2EAF7; }
.category-symbol--gold { color: #AD8100; background: #FBF3D8; }
.category-symbol--green { color: #24835F; background: #E8F5EE; }
.category-symbol--blue { color: #3F78AF; background: #E8F1FA; }
.category-symbol--red { color: #B54950; background: #F9EAEB; }

.home-category-label {
  margin-top: 14rpx;
  color: #29242D;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.category-active-mark {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 34rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #6A2E96;
  transform: translateX(-50%);
}

.guide-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 34rpx 12rpx 18rpx;
  box-sizing: border-box;
}

.guide-section-title {
  color: #211C24;
  font-size: 34rpx;
  font-weight: 800;
}

.new-mark {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  color: #5A2D7A;
  background: #EFE5F7;
  font-size: 18rpx;
  font-weight: 600;
  vertical-align: middle;
}

.view-all {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 0;
  max-width: none;
  height: 64rpx;
  margin: 0 0 0 auto !important;
  padding: 0 4rpx 0 20rpx;
  color: #665F70;
  background: transparent;
  font-size: 22rpx;
  line-height: 64rpx;
}

.guide-list {
  width: 100%;
  overflow: hidden;
  border: 1rpx solid #ECE6EF;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 32rpx rgba(55,38,69,.08);
  box-sizing: border-box;
}

.guide-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100% !important;
  min-width: 100%;
  max-width: 100%;
  min-height: 156rpx;
  margin: 0 !important;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #EEE9F1;
  border-radius: 0;
  color: #211C24;
  background: #FFFFFF;
  text-align: left;
  line-height: 1.45;
  box-sizing: border-box;
}

.guide-row:last-child {
  border-bottom: 0;
}

.guide-fresh-dot {
  position: absolute;
  left: -7rpx;
  top: 28rpx;
  width: 13rpx;
  height: 13rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  background: #FF493E;
  box-sizing: content-box;
}

.guide-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 800;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.28);
}

.guide-symbol--purple { background: linear-gradient(145deg, #8D62CE, #6740A7); }
.guide-symbol--gold { background: linear-gradient(145deg, #E4AF22, #C58A00); }
.guide-symbol--green { background: linear-gradient(145deg, #74B986, #3B9565); }
.guide-symbol--blue { background: linear-gradient(145deg, #6EA8D4, #437DB4); }
.guide-symbol--red { background: linear-gradient(145deg, #D56D72, #B8404A); }

.guide-main {
  min-width: 0;
  flex: 1;
}

.guide-name-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.guide-name {
  min-width: 0;
  flex: 1;
  color: #211C24;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.4;
}

.latest-mark {
  flex: 0 0 auto;
  margin-top: 1rpx;
  padding: 3rpx 7rpx;
  border: 1rpx solid #FF625A;
  border-radius: 7rpx;
  color: #FF4339;
  background: #FFFFFF;
  font-size: 16rpx;
  line-height: 1.25;
}

.guide-summary {
  margin-top: 8rpx;
  color: #5E5768;
  font-size: 21rpx;
  line-height: 1.5;
}

.guide-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 9rpx;
}

.guide-scope {
  min-width: 0;
  flex: 1;
  color: #786F81;
  font-size: 19rpx;
  line-height: 1.4;
}

.guide-updated {
  flex: 0 0 auto;
  color: #908897;
  font-size: 17rpx;
  line-height: 1.4;
}

.guide-arrow {
  flex: 0 0 auto;
  color: #8B8492;
  font-size: 43rpx;
  line-height: 1;
}

.empty-help {
  max-width: 540rpx;
  color: #817A84;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.load-more-state {
  padding: 28rpx 0 8rpx;
  color: #817A84;
  font-size: 22rpx;
  text-align: center;
}

.load-more-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding-top: 24rpx;
  color: #817A84;
  font-size: 22rpx;
}

.load-more-button {
  height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 36rpx;
  color: #4B1F6F;
  background: #EFE8F4;
  font-size: 22rpx;
  line-height: 72rpx;
}

.guide-footnote {
  margin-top: 34rpx;
  color: #918A95;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
