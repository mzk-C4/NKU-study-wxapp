<view class="page courses-page">
  <view class="search-box" bindtap="openSearch"><view class="search-icon"></view><text>搜索课程、教师或标签</text></view>
  <view class="category-bar section"><view wx:for="{{groupOptions}}" wx:key="*this" class="category {{(item === '全部' && !group) || item === group ? 'category--active' : ''}}" data-value="{{item}}" bindtap="chooseGroup">{{item}}</view></view>
  <view class="filters"><view class="filter" bindtap="chooseTerm">{{term || '修读阶段'}}</view><view class="filter" bindtap="chooseTag">{{tag || '课程标签'}}</view><view class="filter" bindtap="chooseAssessment">{{assessment || '考核方式'}}</view></view>
  <view class="section-head section"><view class="section-title">全部课程</view><view class="micro">共 {{total}} 门</view></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !courses.length}}" empty-text="没有找到相关课程" bindretry="loadCourses"></state-view>
  <view class="course-list" wx:if="{{courses.length}}"><course-card wx:for="{{courses}}" wx:key="id" course="{{item}}" bindselect="openCourse"></course-card></view>
  <view class="load-more" wx:if="{{loadingMore}}">正在加载更多...</view>
  <view class="load-more" wx:elif="{{courses.length && !hasMore}}">已加载全部课程</view>
  <view class="course-fab" bindtap="submitCourse">＋</view>
</view>
