<view class="page courses-page">
  <view class="search-box" bindtap="openSearch"><view class="search-icon"></view><text>搜索课程、教师或标签</text></view>
  <scroll-view scroll-x class="category-scroll section"><view class="category-bar"><view wx:for="{{groups}}" wx:key="*this" class="category {{(item === '全部' && !group) || item === group ? 'category--active' : ''}}" data-value="{{item}}" bindtap="chooseGroup">{{item}}</view></view></scroll-view>
  <view class="filters"><picker range="{{termOptions}}" bindchange="chooseTerm"><view class="filter">{{term || '全部学期'}}</view></picker><picker range="{{tagOptions}}" bindchange="chooseTag"><view class="filter">{{tag || '全部标签'}}</view></picker><picker range="{{assessmentOptions}}" bindchange="chooseAssessment"><view class="filter">{{assessment || '全部考核'}}</view></picker></view>
  <view class="section-head section"><view class="section-title">全部课程</view><view class="micro">共 {{total}} 门</view></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !courses.length}}" empty-text="没有找到相关课程" bindretry="loadCourses"></state-view>
  <course-card wx:for="{{courses}}" wx:key="id" course="{{item}}" bindselect="openCourse"></course-card>
  <view class="micro section" wx:if="{{loadingMore}}">正在加载更多课程…</view>
  <view class="micro section" wx:if="{{!loading && courses.length && courses.length >= total}}">已显示全部课程</view>
  <view class="course-fab" bindtap="submitCourse">＋</view>
</view>
