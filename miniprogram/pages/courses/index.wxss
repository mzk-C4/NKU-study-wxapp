.filter-scroll { white-space: nowrap; margin-top: 20rpx; }
.filter-bar { display: inline-flex; gap: 14rpx; min-width: 100%; padding: 8rpx 2rpx; box-sizing: border-box; }
.filter-scrollbar { position: relative; height: 6rpx; margin-top: 6rpx; overflow: hidden; border-radius: 999rpx; background: var(--nk-soft, #E6DFE9); }
.filter-scrollbar-thumb { position: absolute; top: 0; bottom: 0; border-radius: 999rpx; background: var(--nk-primary, #7A4C99); }
.filter-chip { padding: 0 16rpx; height: 52rpx; margin: 0; display: inline-flex; align-items: center; justify-content: center; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 16rpx; color: var(--nk-muted, #5F5962); background: var(--nk-surface, #FFFFFF); font-size: 20rpx; white-space: nowrap; }
.filter-chip::after, .panel-close::after, .clear-options::after, .clear-all::after, .load-more-button::after { border: 0; }
.filter-chip--active { color: var(--nk-accent, #4B1F6F); border-color: var(--nk-line, #B89BC9); background: var(--nk-soft, #F4EEF7); font-weight: 700; }
.filter-chip--pressed { background: var(--nk-soft, #EEE5F2); }
.filter-panel { margin-top: 14rpx; padding: 24rpx; border: 1rpx solid var(--nk-line, #E1D7E6); border-radius: 24rpx; background: var(--nk-surface, #FFFDF8); box-shadow: 0 12rpx 32rpx rgba(75,31,111,.08); box-sizing: border-box; }
.filter-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.filter-panel-title { color: var(--nk-text, #2B123E); font-size: 26rpx; font-weight: 700; }
.panel-close, .clear-options { min-height: 60rpx; margin: 0; padding: 0 18rpx; color: var(--nk-accent, #6B3A8E); background: transparent; font-size: 21rpx; line-height: 60rpx; }
.option-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.checkbox-option { min-height: 72rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 8rpx; border: 1rpx solid var(--nk-line, #DED5E2); border-radius: 18rpx; color: var(--nk-muted, #5F5962); background: var(--nk-surface, #FFFFFF); box-sizing: border-box; font-size: 22rpx; }
.checkbox-option--active { color: var(--nk-accent, #4B1F6F); border-color: var(--nk-line, #B89BC9); background: var(--nk-soft, #F4EEF7); font-weight: 700; }
.option-checkbox { transform: scale(.82); transform-origin: center; }
.tag-option-scroll { height: 420rpx; margin-top: 20rpx; }
.option-list { padding-bottom: 4rpx; }
.tag-option { min-width: calc(50% - 7rpx); }
.active-filter-row { min-height: 66rpx; margin-top: 18rpx; padding-left: 18rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 18rpx; color: var(--nk-muted, #5F5962); background: var(--nk-soft, #F2EDF4); font-size: 21rpx; }
.load-more-button { width: 100%; height: 76rpx; margin-left: 0; margin-right: 0; border-radius: 20rpx; color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #F0E8F4); font-size: 23rpx; font-weight: 700; }



/* 标签缩小 */
.filter-bar .chip { height: 48rpx; padding: 0 16rpx; font-size: 20rpx; border-radius: 24rpx; }
.filter-bar { gap: 10rpx; }

.filter-chip::after { border: 0; }

.courses-page { padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.course-list-head { margin-top: 26rpx; margin-bottom: 20rpx; gap: 16rpx; }
.course-list-title { color: var(--nk-text, #211C24); font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.course-list-total { color: var(--nk-muted, #6F6972); font-size: 24rpx; font-weight: 400; font-variant-numeric: tabular-nums; }
