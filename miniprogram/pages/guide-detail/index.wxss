.article-title { margin: 18rpx 0; font-size: 48rpx; line-height: 1.35; font-weight: 700; }.article-meta { color: #6F6972; font-size: 21rpx; }.article-lead { margin: 30rpx 0; padding: 24rpx; border-left: 8rpx solid #D7A63C; border-radius: 0 20rpx 20rpx 0; background: #F8EFD9; color: #5E471C; font-size: 24rpx; line-height: 1.7; }.rule-title { padding-left: 16rpx; border-left: 8rpx solid #D7A63C; font-size: 30rpx; font-weight: 700; }
.step { display: grid; grid-template-columns: 54rpx 1fr; gap: 20rpx; margin-top: 26rpx; }.step-number { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #FFFFFF; background: #4B1F6F; font-weight: 700; }.step-title { margin-bottom: 6rpx; font-size: 26rpx; font-weight: 700; }.step-text { color: #6F6972; font-size: 23rpx; line-height: 1.65; }
.related-courses { padding: 24rpx; border: 1rpx solid #E8E2EC; border-radius: 24rpx; background: #FFFDF8; }.small-title { font-size: 28rpx; }.related-course { display: flex; justify-content: space-between; padding: 22rpx 0; border-top: 1rpx solid #E8E2EC; font-size: 24rpx; }
.unavailable-card { margin-top: 40rpx; text-align: center; }
