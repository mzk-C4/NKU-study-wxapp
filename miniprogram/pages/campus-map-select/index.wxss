page { background:var(--nk-bg, #F6F3F7); color:var(--nk-text, #211C24); }
.map-choice-page { max-width:640px; margin:0 auto; padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.page-header { padding:4rpx 4rpx 28rpx; }
.page-eyebrow { color:var(--nk-accent, #7650A5); font-size:23rpx; line-height:1.5; }
.page-title { margin-top:8rpx; font-size:40rpx; font-weight:600; line-height:1.4; }
.page-description { margin-top:12rpx; font-size:25rpx; color:var(--nk-muted, #716A7D); line-height:1.65; }
.map-card { margin-bottom:24rpx; padding:28rpx; border:1rpx solid var(--nk-line, #E8E2EC); box-sizing:border-box; border-radius:24rpx; background:var(--nk-surface, #fff); }
.card-heading { display:flex; align-items:center; gap:18rpx; flex-wrap:wrap; }
.map-symbol { display:flex; align-items:center; justify-content:center; flex:none; width:72rpx; height:72rpx; border-radius:18rpx; background:var(--nk-soft, #F3EDF8); color:var(--nk-accent, #7650A5); font-size:28rpx; font-weight:600; }
.map-symbol--spatial { border:1rpx solid var(--nk-line, #DCD0E6); box-sizing:border-box; background:var(--nk-surface, #fff); }
.card-heading-main { flex:1; min-width:0; }
.card-title { font-size:30rpx; font-weight:600; line-height:1.45; }
.card-scope { margin-top:6rpx; font-size:23rpx; color:var(--nk-muted, #716A7D); line-height:1.5; }
.card-purpose { font-size:22rpx; color:var(--nk-muted, #716A7D); line-height:1.5; }
.card-description { margin-top:24rpx; font-size:26rpx; font-weight:400; line-height:1.65; }
.card-tags { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:14rpx; }
.tag { padding:4rpx 14rpx; border-radius:8rpx; font-size:22rpx; line-height:1.5; background:var(--nk-bg, #F6F3F7); color:var(--nk-muted, #716A7D); }
.card-credit { display:flex; align-items:baseline; flex-wrap:wrap; gap:8rpx; margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid var(--nk-line, #EEE8F1); font-size:23rpx; font-weight:400; line-height:1.6; }
.credit-label, .credit-team { color:var(--nk-muted, #716A7D); }
.credit-label { margin-right:8rpx; }
.credit-name { color:var(--nk-text, #211C24); }
.map-action { display:flex; align-items:center; justify-content:center; gap:16rpx; width:100% !important; min-height:88rpx; margin:20rpx 0 0 !important; padding:16rpx 24rpx; box-sizing:border-box; border-radius:16rpx; background:var(--nk-primary, #4B1F6F); color:#fff; font-size:27rpx; font-weight:500; line-height:1.5; }
.map-action::after { border:0; }
.map-action--soft { color:var(--nk-accent, #7650A5); background:var(--nk-soft, #F3EDF8); }
.map-action--pressed { opacity:.8; }
.map-action[disabled] { color:var(--nk-muted, #716A7D); background:var(--nk-bg, #F6F3F7); }
.action-arrow { font-size:30rpx; line-height:1; }
.page-note { display:flex; align-items:center; justify-content:center; gap:16rpx; padding:4rpx 8rpx; color:var(--nk-muted, #716A7D); font-size:22rpx; line-height:1.6; }
.note-line { width:36rpx; height:1rpx; background:var(--nk-line, #DED5E2); }
@media (max-width:360px) { .card-purpose { display:none; } }
