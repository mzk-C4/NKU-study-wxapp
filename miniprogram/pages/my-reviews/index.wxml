<view class="page">
  <view class="card empty-record" wx:if="{{!loading && !error && !reviews.length}}">登录后提交的评价会显示在这里</view>
  <view class="card record-row" wx:for="{{reviews}}" wx:key="id">
    <view class="record-main">
      <view class="history-name">{{item.course_title}} · {{item.teacher_name}}</view>
      <view class="micro">{{item.rating}} 分{{item.created_date ? ' · ' + item.created_date : ''}}</view>
      <view class="record-body">{{item.body}}</view>
    </view>
    <view class="status {{item.status_class}}">{{item.status_label}}</view>
  </view>
</view>
