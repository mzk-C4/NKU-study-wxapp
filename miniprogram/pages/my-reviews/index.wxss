.history-name { font-weight: 700; font-size: 28rpx; color: var(--nk-text, #2A232E); }
.micro { font-size: 22rpx; color: var(--nk-muted, #9CA3AF); margin-top: 6rpx; }
.record-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding: 22rpx 26rpx; margin-bottom: 16rpx; }
.record-main { flex: 1; min-width: 0; }
.record-body { font-size: 26rpx; color: var(--nk-muted, #4B4550); line-height: 1.6; margin-top: 10rpx; }
.empty-record { text-align: center; color: var(--nk-muted, #9CA3AF); padding: 60rpx 0; }
.status { flex-shrink: 0; font-size: 22rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 999rpx; border: 1rpx solid var(--nk-line, #DED5E2); color: var(--nk-muted, #6F6972); }
.status--approved { color: var(--nk-green, #16a34a); border-color: var(--nk-line, #bbf7d0); }
.status--pending, .status--needs_changes { color: var(--nk-gold, #a16207); border-color: var(--nk-line, #fde68a); }
.status--rejected, .status--hidden { color: var(--nk-red, #dc2626); border-color: var(--nk-line, #fecaca); }
