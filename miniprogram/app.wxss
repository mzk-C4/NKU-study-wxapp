page {
  min-height: 100%;
  background: #F6F3F7;
  color: #211C24;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button::after { border: 0; }
.page { min-height: 100vh; padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.page--purple { background: #4B1F6F; }
.section { margin-top: 36rpx; }
.section-title { font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-link { color: #4B1F6F; font-size: 24rpx; font-weight: 600; }
.muted { color: #6F6972; }
.micro { color: #6F6972; font-size: 22rpx; line-height: 1.5; }
.card { background: #FFFDF8; border: 1rpx solid #E8E2EC; border-radius: 26rpx; padding: 26rpx; box-sizing: border-box; }
.card + .card { margin-top: 20rpx; }
.search-box { display: flex; align-items: center; height: 88rpx; padding: 0 26rpx; border: 1rpx solid #E8E2EC; border-radius: 24rpx; background: #FFFFFF; color: #817A84; box-sizing: border-box; }
.search-icon { width: 30rpx; height: 30rpx; margin-right: 16rpx; border: 4rpx solid currentColor; border-radius: 50%; box-sizing: border-box; position: relative; }
.search-icon::after { content: ""; position: absolute; width: 13rpx; height: 4rpx; right: -10rpx; bottom: -5rpx; transform: rotate(45deg); border-radius: 2rpx; background: currentColor; }
.chips { display: flex; gap: 14rpx; overflow-x: auto; white-space: nowrap; }
.chip { display: inline-flex; align-items: center; justify-content: center; padding: 6rpx 18rpx; border: 1rpx solid #E8E2EC; border-radius: 22rpx; background: #FFFFFF; color: #635D66; font-size: 22rpx; box-sizing: border-box; white-space: nowrap; }
.chip--active { color: #FFFFFF; border-color: #4B1F6F; background: #4B1F6F; font-weight: 700; }
.button { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 22rpx; font-size: 28rpx; font-weight: 700; }
.button--primary { color: #FFFFFF; background: #4B1F6F; }
.button--secondary { color: #4B1F6F; background: #EFE8F4; }
.button--ghost { color: #4B1F6F; background: #FFFFFF; border: 1rpx solid #E8E2EC; }
.button[disabled] { opacity: .48; }
.notice { display: flex; gap: 14rpx; padding: 22rpx; border-radius: 22rpx; background: #F8EFD9; color: #6F5014; font-size: 22rpx; line-height: 1.55; }
.notice-mark { flex: 0 0 auto; display: grid; place-items: center; width: 30rpx; height: 30rpx; border: 2rpx solid currentColor; border-radius: 50%; font-weight: 700; }
.field { margin-bottom: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #4C464F; font-size: 24rpx; font-weight: 700; }
.input, .picker, .textarea { width: 100%; border: 1rpx solid #E8E2EC; border-radius: 20rpx; background: #FFFFFF; box-sizing: border-box; font-size: 26rpx; }
.input, .picker { height: 84rpx; padding: 0 24rpx; line-height: 84rpx; }
.textarea { min-height: 160rpx; padding: 22rpx 24rpx; }
.empty-space { height: 120rpx; }
.sticky-footer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,253,248,.98); border-top: 1rpx solid #E8E2EC; }
.two-buttons { display: grid; grid-template-columns: 1fr 2fr; gap: 16rpx; }
.divider { height: 1rpx; background: #E8E2EC; }

/* FB-18: 暗色模式全局适配 */
@media (prefers-color-scheme: dark) {
  page { background: #1A1520; color: #E0DCE4; }
  .page { background: #1A1520; }
  .muted { color: #8B8090; }
  .micro { color: #8B8090; }
  .card { background: #211C28; border-color: #2D2838; }
  .section-title { color: #E8CF96; }
  .section-link { color: #C9B8D8; }
  .search-box { background: #211C28; border-color: #2D2838; color: #8B8090; }
  .chip { background: #211C28; border-color: #2D2838; color: #8B8090; }
  .chip--active { background: #4B1F6F; border-color: #4B1F6F; color: #FFFFFF; }
  .button--ghost { background: #211C28; border-color: #2D2838; color: #C9B8D8; }
  .button--secondary { background: #2D2438; color: #C9B8D8; }
  .notice { background: #2D2818; color: #D4BC8A; }
  .field-label { color: #A8A0B0; }
  .input, .picker, .textarea { background: #211C28; border-color: #2D2838; color: #E0DCE4; }
  .sticky-footer { background: rgba(26,21,32,.98); border-top-color: #2D2838; }
  .divider { background: #2D2838; }
}


/* ===== 手动主题覆盖 ===== */
/* 当用户手动切换时，wrapper 上的 class 覆盖 @media 查询 */

/* 强制亮色（系统暗色 + 用户选亮色） */
.theme-force-light,
.theme-force-light .card { background: #FFFDF8 !important; border-color: #E8E2EC !important; }
.theme-force-light { background: #F6F3F7 !important; color: #211C24 !important; }
.theme-force-light .muted,
.theme-force-light .micro { color: #6F6972 !important; }
.theme-force-light .section-title { color: #211C24 !important; }
.theme-force-light .search-box { background: #FFFFFF !important; border-color: #E8E2EC !important; color: #817A84 !important; }
.theme-force-light .chip { background: #FFFFFF !important; border-color: #E8E2EC !important; color: #635D66 !important; }
.theme-force-light .chip--active { background: #4B1F6F !important; border-color: #4B1F6F !important; color: #FFFFFF !important; }
.theme-force-light .button--ghost { background: #FFFFFF !important; border-color: #E8E2EC !important; color: #4B1F6F !important; }
.theme-force-light .button--secondary { background: #EFE8F4 !important; color: #4B1F6F !important; }
.theme-force-light .notice { background: #F8EFD9 !important; color: #6F5014 !important; }
.theme-force-light .field-label { color: #4C464F !important; }
.theme-force-light .input,
.theme-force-light .picker,
.theme-force-light .textarea { background: #FFFFFF !important; border-color: #E8E2EC !important; color: #211C24 !important; }
.theme-force-light .sticky-footer { background: rgba(255,253,248,.98) !important; border-top-color: #E8E2EC !important; }
.theme-force-light .divider { background: #E8E2EC !important; }

/* 强制暗色（系统亮色 + 用户选暗色） */
.theme-force-dark,
.theme-force-dark .card { background: #211C28 !important; border-color: #2D2838 !important; }
.theme-force-dark { background: #1A1520 !important; color: #E0DCE4 !important; }
.theme-force-dark .muted,
.theme-force-dark .micro { color: #8B8090 !important; }
.theme-force-dark .section-title { color: #E8CF96 !important; }
.theme-force-dark .search-box { background: #211C28 !important; border-color: #2D2838 !important; color: #8B8090 !important; }
.theme-force-dark .chip { background: #211C28 !important; border-color: #2D2838 !important; color: #8B8090 !important; }
.theme-force-dark .chip--active { background: #4B1F6F !important; border-color: #4B1F6F !important; color: #FFFFFF !important; }
.theme-force-dark .button--ghost { background: #211C28 !important; border-color: #2D2838 !important; color: #C9B8D8 !important; }
.theme-force-dark .button--secondary { background: #2D2438 !important; color: #C9B8D8 !important; }
.theme-force-dark .notice { background: #2D2818 !important; color: #D4BC8A !important; }
.theme-force-dark .field-label { color: #A8A0B0 !important; }
.theme-force-dark .input,
.theme-force-dark .picker,
.theme-force-dark .textarea { background: #211C28 !important; border-color: #2D2838 !important; color: #E0DCE4 !important; }
.theme-force-dark .sticky-footer { background: rgba(26,21,32,.98) !important; border-top-color: #2D2838 !important; }
.theme-force-dark .divider { background: #2D2838 !important; }

/* 暗色模式下通用补充（media query 遗漏的） */
@media (prefers-color-scheme: dark) {
  .profile-stats { background: #211C28 !important; border-color: #2D2838 !important; }
  .metric { background: #211C28 !important; border-color: #2D2838 !important; }
  .quick-grid { color: #E0DCE4; }
  .review-card { background: #211C28 !important; border-color: #2D2838 !important; }
  .review-avatar { background: #2D2438 !important; }
  .score-card { background: #211C28 !important; }
  .detail-hero { background: #211C28 !important; }
  .detail-tabs { background: #211C28 !important; }
  .detail-tab { color: #8B8090 !important; }
  .detail-tab--active { color: #E8CF96 !important; border-color: #E8CF96 !important; }
  .about-sheet { background: #211C28 !important; }
  .about-mask { background: rgba(0,0,0,.6) !important; }
  .feedback-sheet { background: #211C28 !important; }
  .login-button { background: #2D2438 !important; }
  .hero-button { background: #2D2438 !important; border-color: #2D2838 !important; color: #C9B8D8 !important; }
  .hero { background: #211C28 !important; }
  .brand-row { color: #E0DCE4 !important; }
  .season-card { background: #2D2438 !important; }
  .record-row { background: #211C28 !important; border-color: #2D2838 !important; }
  .status { color: #A8A0B0 !important; }
  .reaction-button { background: #2D2438 !important; border-color: #2D2838 !important; }
  .course-zone { background: #2D2438 !important; color: #C9B8D8 !important; }
  .file-icon { background: #2D2438 !important; color: #C9B8D8 !important; }
  .link-ok { color: #7BAA7B !important; }
  .open-link { color: #C9B8D8 !important; }
}
