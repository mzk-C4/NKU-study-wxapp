@import "./styles/typography.wxss";

page {
  min-height: 100%;
  background: var(--nk-bg, #F6F3F7);
  color: var(--nk-text, #211C24);
  font-family: var(--nk-font-ui, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif);
  font-size: 28rpx;
}

button { color:var(--nk-text, #211C24); }
input, textarea { color:var(--nk-text, #211C24); }
button, input, textarea { font-family:var(--nk-font-ui, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif); }
button::after { border: 0; }
.page { min-height: 100vh; padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.section { margin-top: 36rpx; }
.section-title { font-family:var(--nk-font-song); font-size: 34rpx; line-height: 1.5; font-weight: 600; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-link { color: var(--nk-accent, #4B1F6F); font-size: 24rpx; font-weight: 600; }
.muted { color: var(--nk-muted, #6F6972); }
.micro { color: var(--nk-muted, #6F6972); font-size: 22rpx; line-height: 1.5; }
.card { background: var(--nk-surface, #FFFDF8); border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 26rpx; padding: 26rpx; box-sizing: border-box; }
.card + .card { margin-top: 20rpx; }
.search-box { display: flex; align-items: center; height: 88rpx; padding: 0 26rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 24rpx; background: var(--nk-surface, #FFFFFF); color: var(--nk-muted, #817A84); box-sizing: border-box; }
.search-icon { width: 30rpx; height: 30rpx; margin-right: 16rpx; border: 4rpx solid currentColor; border-radius: 50%; box-sizing: border-box; position: relative; }
.search-icon::after { content: ""; position: absolute; width: 13rpx; height: 4rpx; right: -10rpx; bottom: -5rpx; transform: rotate(45deg); border-radius: 2rpx; background: currentColor; }
.chips { display: flex; gap: 14rpx; overflow-x: auto; white-space: nowrap; }
.chip { display: inline-flex; align-items: center; justify-content: center; padding: 6rpx 18rpx; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 22rpx; background: var(--nk-surface, #FFFFFF); color: var(--nk-muted, #635D66); font-size: 22rpx; box-sizing: border-box; white-space: nowrap; }
.chip--active { color: #FFFFFF; border-color: var(--nk-accent, #4B1F6F); background: var(--nk-primary, #4B1F6F); font-weight: 700; }
.button { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 22rpx; font-size: 28rpx; font-weight: 700; }
.button--primary { color: #FFFFFF; background: var(--nk-primary, #4B1F6F); }
.button--secondary { color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #EFE8F4); }
.button--ghost { color: var(--nk-accent, #4B1F6F); background: var(--nk-surface, #FFFFFF); border: 1rpx solid var(--nk-line, #E8E2EC); }
.button[disabled] { opacity: .48; }
.notice { display: flex; gap: 14rpx; padding: 22rpx; border-radius: 22rpx; background: var(--nk-gold-soft, #F8EFD9); color: var(--nk-gold, #6F5014); font-size: 22rpx; line-height: 1.55; }
.notice-mark { flex: 0 0 auto; display: grid; place-items: center; width: 30rpx; height: 30rpx; border: 2rpx solid currentColor; border-radius: 50%; font-weight: 700; }
.field { margin-bottom: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: var(--nk-muted, #4C464F); font-size: 24rpx; font-weight: 700; }
.input, .picker, .textarea { width: 100%; border: 1rpx solid var(--nk-line, #E8E2EC); border-radius: 20rpx; background: var(--nk-surface, #FFFFFF); color: var(--nk-text, #211C24); box-sizing: border-box; font-size: 26rpx; }
.input, .picker { height: 84rpx; padding: 0 24rpx; line-height: 84rpx; }
.textarea { min-height: 160rpx; padding: 22rpx 24rpx; }
.empty-space { height: 120rpx; }
.sticky-footer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--nk-surface, rgba(255,253,248,.98)); border-top: 1rpx solid var(--nk-line, #E8E2EC); }
.divider { height: 1rpx; background: var(--nk-soft, #E8E2EC); }

/* Theme variables are owned by utils/theme.js and applied through page-meta. */
/* Shared local-draft status: native controls, NKU purple, warm-white surfaces. */
.draft-bar { display:flex; align-items:center; gap:12rpx; padding:14rpx 18rpx; margin-bottom:20rpx; border-radius:18rpx; background:var(--nk-soft, #EFE8F4); }
.draft-note { flex:1; min-width:0; color:var(--nk-accent, #4B1F6F); font-size:24rpx; line-height:1.6; }
.draft-clear { width:auto !important; flex:none; margin:0 !important; padding:0 12rpx; min-height:72rpx; line-height:72rpx; font-size:24rpx; color:var(--nk-accent, #4B1F6F); background:transparent; }
.draft-clear::after, .feedback-type::after { border:0; }
.field-counter { margin-top:10rpx; color:var(--nk-muted, #6F6972); text-align:right; font-size:22rpx; font-variant-numeric:tabular-nums; }
.feedback-type { width:auto !important; max-width:100%; margin:0 !important; padding:14rpx 22rpx; min-height:72rpx; border:1rpx solid var(--nk-line, #DED5E2); border-radius:18rpx; color:var(--nk-muted, #6F6972); background:var(--nk-surface, #FFFDF8); font-size:24rpx; line-height:1.5; }
.feedback-type--active { color:var(--nk-accent, #4B1F6F); border-color:var(--nk-accent, #4B1F6F); background:var(--nk-soft, #EFE8F4); font-weight:700; }
