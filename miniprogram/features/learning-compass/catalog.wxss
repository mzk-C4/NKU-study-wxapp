.catalog-page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); background: var(--nk-bg, #F6F3F7); min-height: 100vh; box-sizing: border-box; }
.catalog-hero { padding: 28rpx; background: linear-gradient(135deg,var(--nk-soft, #F2EAF7),var(--nk-soft, #FFF9EB)); border-radius: 28rpx; }
.catalog-eyebrow { color: var(--nk-gold, #886638); font-size: 20rpx; letter-spacing: 2rpx; }
.catalog-title { color: var(--nk-text, #301746); font-size: 42rpx; font-weight: 800; margin: 12rpx 0; }
.catalog-description,.catalog-summary { font-size: 25rpx; line-height: 1.65; color: var(--nk-muted, #746C7C); }
.catalog-search { display: flex; align-items: center; gap: 14rpx; border: 2rpx solid var(--nk-line, #D7C9E6); border-radius: 40rpx; padding: 8rpx 22rpx; margin: 26rpx 0 16rpx; background: var(--nk-surface, #FFF); }
.catalog-search input { min-width: 0; flex: 1; height: 72rpx; font-size: 27rpx; }
.catalog-search-mark { font-size: 44rpx; color: var(--nk-accent, #67358A); }
.catalog-clear { flex: 0 0 60rpx; width: 60rpx!important; padding: 0!important; margin: 0!important; background: transparent; color: var(--nk-accent, #67358A); }
.catalog-suggestions,.catalog-kinds,.catalog-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.catalog-suggestions button,.catalog-kinds button,.catalog-tabs button { width: auto!important; margin: 0!important; padding: 10rpx 18rpx!important; font-size: 24rpx; line-height: 1.6; border-radius: 20rpx; color: var(--nk-muted, #706577); background: var(--nk-soft, #F5F1F7); }
.catalog-tabs .selected,.catalog-kinds .selected { background: var(--nk-primary, #4B1F6F); color: #FFF; }
.catalog-count,.catalog-footnote { font-size: 22rpx; line-height: 1.6; color: var(--nk-muted, #837889); margin: 24rpx 0; }
.catalog-row { display: flex; align-items: flex-start; gap: 18rpx; width: 100%!important; margin: 0 0 18rpx!important; padding: 26rpx 22rpx!important; border: 1rpx solid var(--nk-line, #ECE5F1); border-radius: 24rpx; text-align: left; background: var(--nk-surface, #FFF); box-sizing: border-box; }
.catalog-main { flex: 1; min-width: 0; }
.catalog-item-title { display: block; font-size: 29rpx; font-weight: 700; color: var(--nk-text, #2D2035); line-height: 1.5; margin-bottom: 8rpx; }
.catalog-summary { display: block; }
.catalog-meta { margin-top: 12rpx; font-size: 21rpx; color: var(--nk-muted, #8F7A9F); line-height: 1.6; }
.catalog-badge { flex: 0 0 60rpx; padding: 20rpx 0; border-radius: 14rpx; background: var(--nk-soft, #F2EAF7); color: var(--nk-accent, #67358A); font-size: 20rpx; text-align: center; }
.catalog-badge--pdf { background: var(--nk-gold-soft, #FAF1DA); color: var(--nk-gold, #947426); }
.catalog-arrow { color: var(--nk-accent, #67358A); font-size: 34rpx; }
.catalog-warning { border-radius: 16rpx; padding: 20rpx; color: var(--nk-gold, #785C22); background: var(--nk-gold-soft, #FFF5DF); font-size: 24rpx; }
.catalog-warning button,.catalog-more { font-size: 24rpx; color: var(--nk-accent, #4B1F6F); background: var(--nk-soft, #F5EFF9); border-radius: 18rpx; margin-top: 16rpx; white-space: normal; }
.catalog-page button::after { border: 0; }

.catalog-ai {
  width: 100% !important;
  margin: 16rpx 0 !important;
  padding: 22rpx;
  min-height: 88rpx;
  font-size: 26rpx;
  text-align: left;
  color: var(--nk-accent, #4B1F6F);
  background: var(--nk-surface, #FFFDF8);
  border-radius: 18rpx;
}
